    <!-- Document Upload Functions -->
    <script>
        // Document upload functionality for Setup page
        function uploadDocument(type) {
            console.log('Uploading document type:', type);
            
            const input = document.getElementById(type + 'Input');
            if (!input) {
                console.error('Input element not found:', type + 'Input');
                return;
            }
            
            input.click();
        }

        // Handle file selection and upload
        function handleFileUpload(type, file) {
            if (!file) return;
            
            // Validate file type
            const allowedTypes = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png'];
            if (!allowedTypes.includes(file.type)) {
                Swal.fire({
                    icon: 'error',
                    title: 'Invalid File Type',
                    text: 'Please upload PDF, JPG, JPEG, or PNG files only.'
                });
                return;
            }
            
            // Validate file size (max 5MB)
            if (file.size > 5 * 1024 * 1024) {
                Swal.fire({
                    icon: 'error',
                    title: 'File Too Large',
                    text: 'Please upload files smaller than 5MB.'
                });
                return;
            }
            
            // Show loading
            Swal.fire({
                title: 'Uploading Document...',
                text: 'Please wait while we upload your document.',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            
            // Convert file to base64
            const reader = new FileReader();
            reader.onload = function(e) {
                const base64Data = e.target.result;
                
                // Save to Firebase
                saveDocumentToFirebase(type, {
                    fileName: file.name,
                    fileType: file.type,
                    fileSize: file.size,
                    fileData: base64Data,
                    uploadedAt: new Date().toISOString()
                });
            };
            reader.readAsDataURL(file);
        }

        // Save document to Firebase
        async function saveDocumentToFirebase(type, documentData) {
            try {
                const response = await fetch('/api/settings/upload-document', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        documentType: type,
                        documentData: documentData
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Show success message
                    Swal.fire({
                        icon: 'success',
                        title: 'Document Uploaded',
                        text: 'Your document has been uploaded successfully!',
                        timer: 2000,
                        showConfirmButton: false
                    });
                    
                    // Update UI to show uploaded document
                    showUploadedDocument(type, documentData.fileName);
                } else {
                    throw new Error(result.message || 'Upload failed');
                }
            } catch (error) {
                console.error('Error uploading document:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Upload Failed',
                    text: 'Failed to upload document. Please try again.'
                });
            }
        }

        // Show uploaded document in UI
        function showUploadedDocument(type, fileName) {
            const statusElement = document.getElementById(type + 'Status');
            const fileNameElement = document.getElementById(type + 'FileName');
            
            if (statusElement && fileNameElement) {
                fileNameElement.textContent = fileName;
                statusElement.style.display = 'block';
            }
        }

        // Remove document
        async function removeDocument(type) {
            const result = await Swal.fire({
                title: 'Remove Document?',
                text: 'Are you sure you want to remove this document?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, remove it!'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch('/api/settings/remove-document', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            documentType: type
                        })
                    });
                    
                    const result = await response.json();
                    
                    if (result.success) {
                        // Hide status element
                        const statusElement = document.getElementById(type + 'Status');
                        if (statusElement) {
                            statusElement.style.display = 'none';
                        }
                        
                        Swal.fire({
                            icon: 'success',
                            title: 'Document Removed',
                            text: 'Document has been removed successfully.',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        throw new Error(result.message || 'Remove failed');
                    }
                } catch (error) {
                    console.error('Error removing document:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Remove Failed',
                        text: 'Failed to remove document. Please try again.'
                    });
                }
            }
        }

        // Initialize file input event listeners
        document.addEventListener('DOMContentLoaded', function() {
            // Certificate input
            const certificateInput = document.getElementById('certificateInput');
            if (certificateInput) {
                certificateInput.addEventListener('change', function(e) {
                    if (e.target.files.length > 0) {
                        handleFileUpload('certificate', e.target.files[0]);
                    }
                });
            }
            
            // ID input
            const idInput = document.getElementById('idInput');
            if (idInput) {
                idInput.addEventListener('change', function(e) {
                    if (e.target.files.length > 0) {
                        handleFileUpload('id', e.target.files[0]);
                    }
                });
            }
            
            // Additional input
            const additionalInput = document.getElementById('additionalInput');
            if (additionalInput) {
                additionalInput.addEventListener('change', function(e) {
                    if (e.target.files.length > 0) {
                        handleFileUpload('additional', e.target.files[0]);
                    }
                });
            }

            // Load existing documents on page load
            loadExistingDocuments();
        });

        // Load existing documents from Firebase
        async function loadExistingDocuments() {
            try {
                const response = await fetch('/api/settings/get-documents');
                const result = await response.json();
                
                if (result.success && result.documents) {
                    // Show existing documents
                    Object.keys(result.documents).forEach(type => {
                        const doc = result.documents[type];
                        if (doc && doc.fileName) {
                            showUploadedDocument(type, doc.fileName);
                        }
                    });
                }
            } catch (error) {
                console.error('Error loading existing documents:', error);
            }
        }
    </script>

    <script>
        // Missing functions for appointment details
        function viewAppointmentDetails(appointmentId) {
            console.log('Viewing appointment details for:', appointmentId);
            // Navigate to appointments page and show details
            navigateToAppointments();
            setTimeout(() => {
                if (typeof AppointmentDetails !== 'undefined') {
                    AppointmentDetails.showDetails(appointmentId);
                }
            }, 500);
        }

        function navigateToAppointments() {
            if (typeof dashboardNavigation !== 'undefined') {
                dashboardNavigation.showSection('appointments');
            }
        }

        // Initialize dashboard when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Dashboard initializing...');
            
            // Initialize navigation
            if (typeof DashboardNavigation !== 'undefined') {
                new DashboardNavigation();
            }
            
            // Initialize dashboard appointments
            if (typeof dashboardAppointments !== 'undefined') {
                dashboardAppointments.init();
            }
            
            // Initialize other components
            if (typeof appointmentsPage !== 'undefined') {
                appointmentsPage.init();
            }
            
            if (typeof messagesPage !== 'undefined') {
                console.log('✅ MessagesPage found, initializing...');
                messagesPage.init();
            } else {
                console.error('❌ MessagesPage not found during initialization');
            }
            
            if (typeof settingsPage !== 'undefined') {
                settingsPage.init();
            }
        });
    </script>
</body>
</html> 