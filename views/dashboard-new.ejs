<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Health Center</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Animate.css for animations -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/dashboard-styles.css">
    <link rel="stylesheet" href="/css/chat-avatars.css">
    <link rel="stylesheet" href="/css/chat-professional.css">
    <link rel="stylesheet" href="/css/my-profile-styles.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Audio element for notifications -->
    <audio id="notificationSound" preload="auto">
        <source src="/assets/notification.mp3" type="audio/mpeg">
        <source src="/assets/notification.wav" type="audio/wav">
    </audio>
    
    <!-- Audio element for appointment sound -->
    <audio id="appointmentSound" preload="auto">
        <source src="/assets/appointment.mp3" type="audio/mpeg">
        <source src="/assets/appointment.wav" type="audio/wav">
    </audio>

    <!-- Upload Section Styling -->
    <style>
        .upload-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .upload-item {
            border: 2px dashed #e5e7eb;
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
            background: #fafafa;
        }

        .upload-item:hover {
            border-color: #159BBD;
            background: #f8fbff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(21, 155, 189, 0.1);
        }

        .upload-placeholder i {
            font-size: 2.5rem;
            color: #159BBD;
            margin-bottom: 1rem;
            display: block;
        }

        .upload-placeholder p {
            font-weight: 500;
            color: #374151;
            margin-bottom: 1rem;
            font-size: 1rem;
        }

        .upload-status {
            margin-top: 1rem;
        }

        .upload-status .alert {
            padding: 0.75rem;
            border-radius: 8px;
            font-size: 0.9rem;
            margin-bottom: 0;
        }

        .upload-status .alert-success {
            background-color: #d4edda;
            border-color: #c3e6cb;
            color: #155724;
        }

        .upload-section {
            padding: 1rem;
        }

        /* Profile Page Styles */
        .hospital-info-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: 1fr 1fr;
        }

        .hospital-info-grid .info-item.full-width {
            grid-column: 1 / -1;
        }

        .info-item {
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 4px solid #007bff;
        }

        .info-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: #495057;
            margin-bottom: 0.5rem;
        }

        .info-value {
            font-size: 1rem;
            color: #212529;
            font-weight: 500;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 0.5rem;
        }

        .service-item {
            padding: 0.5rem;
            background: #f8f9fa;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .schedule-grid {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .schedule-item {
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid #dee2e6;
        }

        .schedule-item.active {
            background: #e8f5e8;
            border-color: #28a745;
        }

        .schedule-item.inactive {
            background: #f8f9fa;
            border-color: #dee2e6;
            opacity: 0.7;
        }

        .day-header {
            display: flex;
            justify-content: between;
            align-items: center;
            margin-bottom: 0.5rem;
        }

        .day-name {
            font-weight: 600;
            color: #495057;
        }

        .status-badge {
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.8rem;
            color: white;
        }

        .time-slots {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .time-slot {
            padding: 0.25rem 0.5rem;
            background: #007bff;
            color: white;
            border-radius: 4px;
            font-size: 0.8rem;
        }

        .profile-stats .stat-item {
            padding: 1rem 0;
            border-bottom: 1px solid #dee2e6;
        }

        .profile-stats .stat-item:last-child {
            border-bottom: none;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #6c757d;
            margin-bottom: 0.5rem;
        }

        .stat-value {
            font-size: 1rem;
            font-weight: 500;
            color: #495057;
        }

        .rating-stars i {
            font-size: 0.9rem;
        }

        .empty-state {
            text-align: center;
            padding: 2rem;
        }

        .empty-state i {
            font-size: 2rem;
        }

        @media (max-width: 768px) {
            .hospital-info-grid {
                grid-template-columns: 1fr;
            }
            
            .services-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-hospital-alt"></i>
                    <span>HomeCare Plus</span>
                </div>
            </div>
            
            <div class="sidebar-user">
                <div class="user-avatar">
                    <i class="fas fa-user-md"></i>
                </div>
                <div class="user-info">
                    <h6><%= user.clinicName || 'Admin' %></h6>
                    <span>Administrator</span>
                </div>
            </div>
            
            <ul class="sidebar-nav">
                <li class="nav-item active">
                    <a href="#dashboard" class="nav-link">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#appointments" class="nav-link">
                        <i class="fas fa-calendar-check"></i>
                        <span>Appointments</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#messages" class="nav-link">
                        <i class="fas fa-comments"></i>
                        <span>Messages</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#profile" class="nav-link" id="profile-link">
                        <i class="fas fa-user-circle"></i>
                        <span>Profile</span>
                    </a>
                </li>
                <li class="nav-item" style="display: none;">
                    <a href="#settings" class="nav-link" id="settings-link">
                        <i class="fas fa-cog"></i>
                        <span>Settings</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#my-profile" class="nav-link" id="my-profile-link">
                        <i class="fas fa-tools"></i>
                        <span>Setup</span>
                    </a>
                </li>
            </ul>
            
            <div class="sidebar-footer">
                <a href="/logout" class="nav-link">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </div>
        </nav>
        
        <!-- Main Content -->
        <main class="main-content">
            <!-- Top Header -->
            <header class="top-header">
                <div class="header-left">
                    <button class="sidebar-toggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="header-title">
                        <h1 class="mb-1"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</h1>
                        <p class="text-muted mb-0" style="font-size:1.1rem;font-weight:500;">Welcome back, <span style="color:var(--primary-color);font-weight:700"><%= user.clinicName || 'Admin' %></span>! Here is your professional overview for today.</p>
                    </div>
                </div>
                <div class="header-right d-flex align-items-center gap-3">
                    <div class="d-flex flex-column align-items-end me-3">
                        <span class="fw-bold" style="color:var(--primary-color); font-size: 1.2rem;">
                            <i class="fas fa-calendar-day me-2"></i>
                            <%= new Date().toLocaleDateString('en-US', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                        </span>
                        <span class="text-secondary" style="font-size:0.95rem;">
                            <i class="fas fa-clock me-1"></i>
                            <%= new Date().toLocaleTimeString('en-US', {hour:'2-digit', minute:'2-digit'}) %>
                        </span>
                    </div>
                </div>
            </header>
            
            <!-- Dashboard Content -->
            <div class="dashboard-content">
                <!-- Key Metrics Section (Top Horizontal) -->
                <div class="key-metrics-section mb-4">
                    <div class="row">
                        <div class="col-xl-4 col-md-4 mb-3">
                            <div class="metric-card">
                                <div class="metric-icon bg-primary">
                                    <i class="fas fa-calendar-alt"></i>
                            </div>
                                <div class="metric-content">
                                    <h3 id="totalAppointments">--</h3>
                                    <p>Total Appointments</p>
                                    <span class="metric-subtitle">All time</span>
                            </div>
                        </div>
                    </div>
                        <div class="col-xl-4 col-md-4 mb-3">
                            <div class="metric-card">
                                <div class="metric-icon bg-success">
                                    <i class="fas fa-check-circle"></i>
                            </div>
                                <div class="metric-content">
                                    <h3 id="approvedAppointments">--</h3>
                                    <p>Approved Appointments</p>
                                    <span class="metric-subtitle">This month</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-4 col-md-4 mb-3">
                            <div class="metric-card">
                                <div class="metric-icon bg-warning">
                                    <i class="fas fa-clock"></i>
                                </div>
                                <div class="metric-content">
                                    <h3 id="pendingAppointments">--</h3>
                                    <p>Pending Appointments</p>
                                    <span class="metric-subtitle">Awaiting approval</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Main Dashboard Row -->
                <div class="row">
                    <!-- Center: Appointment Trends Chart -->
                    <div class="col-xl-8 col-lg-7 mb-4">
                        <div class="content-card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <div class="header-content">
                                    <h5 class="mb-0">
                                        <i class="fas fa-chart-line text-primary me-2"></i>
                                        Appointment Trends
                                    </h5>
                                    <p class="text-muted mb-0 mt-1">Weekly appointment analytics and patterns</p>
                                </div>
                                <div class="header-actions">
                                    <select class="form-select form-select-sm" id="trendsTimeRange">
                                        <option value="7">Last 7 days</option>
                                        <option value="30" selected>Last 30 days</option>
                                        <option value="90">Last 3 months</option>
                                    </select>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="chart-container">
                                    <canvas id="appointmentTrendsChart" width="400" height="200"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Right: Upcoming Appointments (Enhanced Professional Design) -->
                    <div class="col-xl-4 col-lg-5 mb-4">
                        <div class="content-card upcoming-appointments-card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <div class="header-content">
                                    <h5 class="mb-0">
                                        <i class="fas fa-calendar-check me-2"></i>
                                        Upcoming Appointments
                                    </h5>
                                    <p class="text-muted mb-0 mt-1">Next scheduled patient visits</p>
                                </div>
                                <div class="header-actions">
                                    <button class="btn btn-outline-primary btn-sm me-2" onclick="dashboardAppointments.refresh()" title="Refresh appointments">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                    <button class="btn btn-primary btn-sm" onclick="navigateToAppointments()" title="View all appointments">
                                        <i class="fas fa-list me-1"></i>
                                        View All
                                    </button>
                            </div>
                                        </div>
                            <div class="card-body p-0">
                                <div class="upcoming-appointments-container">
                                    <div class="simplified-appointments-list" id="upcomingAppointmentsList">
                                        <!-- Enhanced appointments with patient profiles will be loaded here -->
                                    <div class="loading-state">
                                        <div class="spinner-container">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                        </div>
                                        </div>
                                            <p class="loading-text">Loading upcoming appointments...</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                                        </div>
                                    </div>
                                    
            <!-- Settings Content (Hidden by default) -->
            <div class="settings-content" id="settings-content" style="display: none;">
                <!-- Settings Header -->
                <div class="settings-header mb-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="header-content">
                                <h2 class="mb-2">
                                    <i class="fas fa-cog text-primary me-3"></i>
                                    Clinic Settings
                                </h2>
                                <p class="text-muted mb-0">Manage your clinic information, preferences, and account settings</p>
                                        </div>
                                        </div>
                        <div class="col-md-4 text-end">
                            <div class="header-actions">
                                <button class="btn btn-primary" onclick="settingsPage.saveAllSettings()">
                                    <i class="fas fa-save me-2"></i>Save All Changes
                                            </button>
                            </div>
                        </div>
                                        </div>
                                    </div>
                                    
                <!-- Settings Statistics -->
                <div class="row mb-4">
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="stat-card-settings">
                            <div class="stat-icon bg-primary">
                                <i class="fas fa-user-check"></i>
                                        </div>
                            <div class="stat-content">
                                <h3 id="profileCompletion">85%</h3>
                                <p>Profile Complete</p>
                                        </div>
                                        </div>
                                    </div>
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="stat-card-settings">
                            <div class="stat-icon bg-success">
                                <i class="fas fa-stethoscope"></i>
                                </div>
                            <div class="stat-content">
                                <h3 id="activeServices">5</h3>
                                <p>Active Services</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="stat-card-settings">
                            <div class="stat-icon bg-warning">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="stat-content">
                                <h3 id="workingDays">6</h3>
                                <p>Working Days</p>
                                </div>
                            </div>
                        </div>
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="stat-card-settings">
                            <div class="stat-icon bg-info">
                                <i class="fas fa-shield-alt"></i>
                    </div>
                            <div class="stat-content">
                                <h3 id="securityLevel">High</h3>
                                <p>Security Level</p>
                </div>
            </div>
                    </div>
                    </div>
                    
                <!-- Settings Management -->
                    <div class="row">
                        <div class="col-12">
                        <div class="content-card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <div class="header-content">
                                    <h5 class="mb-0">
                                        <i class="fas fa-sliders-h text-primary me-2"></i>
                                        Settings Configuration
                                    </h5>
                                    <p class="text-muted mb-0 mt-1">Configure your clinic settings and preferences</p>
                                </div>
                                <div class="header-actions d-flex gap-2">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-outline-primary btn-sm active" data-settings-tab="profile">
                                            <i class="fas fa-user me-1"></i>Profile
                                            </button>
                                        <button type="button" class="btn btn-outline-success btn-sm" data-settings-tab="contact">
                                            <i class="fas fa-phone me-1"></i>Contact
                                            </button>
                                        <button type="button" class="btn btn-outline-warning btn-sm" data-settings-tab="services">
                                            <i class="fas fa-stethoscope me-1"></i>Services
                                            </button>
                                        <button type="button" class="btn btn-outline-info btn-sm" data-settings-tab="schedule">
                                            <i class="fas fa-calendar-alt me-1"></i>Schedule
                                            </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-settings-tab="documents">
                                            <i class="fas fa-file-upload me-1"></i>Documents
                                            </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" data-settings-tab="security">
                                            <i class="fas fa-shield-alt me-1"></i>Security
                                            </button>
                                </div>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="settings-container">
                                    <!-- Profile Settings Tab -->
                                    <div class="settings-tab active" id="profile-tab">
                                        <div class="settings-tab-content">
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="profile-image-section text-center">
                                                        <div class="profile-image-container">
                                                            <img id="profileImage" src="/assets/hospital.PNG" alt="Clinic Profile" class="profile-image">
                                                            <div class="profile-image-overlay">
                                                                <button class="btn btn-light btn-sm" onclick="settingsPage.changeProfileImage()">
                                                                    <i class="fas fa-camera"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <input type="file" id="profileImageInput" accept="image/*" style="display: none;">
                                                        <p class="text-muted mt-2">Click to change profile image</p>
                                                        <div class="profile-status mt-3">
                                                            <span class="badge bg-success">Active</span>
                                                            <span class="badge bg-primary ms-2">Verified</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-8">
                                                    <form id="profileForm" class="settings-form">
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <div class="form-group">
                                                                    <label for="clinicName">
                                                                        <i class="fas fa-hospital text-primary me-2"></i>
                                                                        Clinic Name
                                                                    </label>
                                                                    <input type="text" class="form-control" id="clinicName" name="clinicName" value="<%= user.clinicName || user.name || 'Clinic Name' %>">
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-group">
                                                                    <label for="clinicEmail">
                                                                        <i class="fas fa-envelope text-primary me-2"></i>
                                                                        Email Address
                                                                    </label>
                                                                    <input type="email" class="form-control" id="clinicEmail" name="clinicEmail" value="<%= user.email %>" readonly>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="clinicAbout">
                                                                <i class="fas fa-info-circle text-primary me-2"></i>
                                                                About Clinic
                                                            </label>
                                                            <textarea class="form-control" id="clinicAbout" name="clinicAbout" rows="4" placeholder="Describe your clinic's mission and services..."><%= user.about || '' %></textarea>
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="meetingDuration">
                                                                <i class="fas fa-clock text-primary me-2"></i>
                                                                Appointment Duration (minutes)
                                                            </label>
                                                            <select class="form-control" id="meetingDuration" name="meetingDuration">
                                                                <option value="15">15 minutes</option>
                                                                <option value="30" selected>30 minutes</option>
                                                                <option value="45">45 minutes</option>
                                                                <option value="60">1 hour</option>
                                                            </select>
                                                        </div>
                                                        <div class="form-actions">
                                                        <button type="submit" class="btn btn-primary">
                                                                <i class="fas fa-save me-2"></i>Save Profile
                                                        </button>
                                                            <button type="button" class="btn btn-outline-secondary ms-2" onclick="settingsPage.resetProfileForm()">
                                                                <i class="fas fa-undo me-2"></i>Reset
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                                </div>
                                            </div>
                                        </div>

                                    <!-- Contact Settings Tab -->
                                    <div class="settings-tab" id="contact-tab">
                                        <div class="settings-tab-content">
                                            <form id="contactForm" class="settings-form">
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label for="clinicPhone">
                                                                <i class="fas fa-phone text-primary me-2"></i>
                                                                Phone Number
                                                            </label>
                                                            <input type="tel" class="form-control" id="clinicPhone" name="clinicPhone" placeholder="+250 123 456 789">
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label for="clinicAddress">
                                                                <i class="fas fa-map-marker-alt text-primary me-2"></i>
                                                                Street Address
                                                            </label>
                                                            <input type="text" class="form-control" id="clinicAddress" name="clinicAddress" placeholder="Enter street address">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label for="clinicSector">
                                                                <i class="fas fa-location-dot text-primary me-2"></i>
                                                                Sector
                                                            </label>
                                                            <select class="form-control" id="clinicSector" name="clinicSector">
                                                                <option value="">Select Sector</option>
                                                                <option value="KK (Kacyiru)">KK (Kacyiru)</option>
                                                                <option value="KG (Gasabo)">KG (Gasabo)</option>
                                                                <option value="KN (Nyarugenge)">KN (Nyarugenge)</option>
                                                                <option value="KM (Muhima)">KM (Muhima)</option>
                                                                <option value="KP (Kicukiro)">KP (Kicukiro)</option>
                                                                <option value="KR (Remera)">KR (Remera)</option>
                                                                <option value="KY (Nyamirambo)">KY (Nyamirambo)</option>
                                                                <option value="KC (Kiyovu)">KC (Kiyovu)</option>
                                                                <option value="KI (Kimihurura)">KI (Kimihurura)</option>
                                                                <option value="KG (Gisozi)">KG (Gisozi)</option>
                                                                <option value="KJ (Gikondo)">KJ (Gikondo)</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
