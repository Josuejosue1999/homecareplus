<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Choose Your Path - HomeCare Plus</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/landing.css">
    
    <style>
        .selection-hero {
            background: linear-gradient(135deg, #159BBD 0%, #0D5C73 50%, #0A4A5E 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        
        .selection-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
        }
        
        .selection-content {
            position: relative;
            z-index: 2;
            color: white;
            text-align: center;
            padding: 80px 0;
        }
        
        .selection-title {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }
        
        .selection-subtitle {
            font-size: 1.3rem;
            margin-bottom: 3rem;
            opacity: 0.95;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.6;
        }
        
        .selection-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2.5rem;
            margin-top: 4rem;
            max-width: 1200px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .selection-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(15px);
            border-radius: 25px;
            padding: 3rem 2rem;
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.4s ease;
            text-decoration: none;
            color: inherit;
            position: relative;
            overflow: hidden;
            text-align: center;
        }
        
        .selection-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: all 0.6s ease;
            transform: rotate(45deg) translateX(-100%);
            opacity: 0;
        }
        
        .selection-card:hover::before {
            transform: rotate(45deg) translateX(100%);
            opacity: 1;
        }
        
        .selection-card:hover {
            transform: translateY(-15px) scale(1.02);
            background: rgba(255, 255, 255, 0.15);
            color: white;
            text-decoration: none;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
        }
        
        .selection-icon {
            width: 90px;
            height: 90px;
            margin: 0 auto 2rem;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: white;
            position: relative;
            z-index: 2;
            transition: all 0.3s ease;
        }
        
        .selection-card.patient .selection-icon {
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
            box-shadow: 0 10px 25px rgba(76, 175, 80, 0.3);
        }
        
        .selection-card.health-center .selection-icon {
            background: linear-gradient(135deg, #159BBD 0%, #0D5C73 100%);
            box-shadow: 0 10px 25px rgba(21, 155, 189, 0.3);
        }
        
        .selection-card.administrator .selection-icon {
            background: linear-gradient(135deg, #FF6B6B 0%, #d63031 100%);
            box-shadow: 0 10px 25px rgba(255, 107, 107, 0.3);
        }
        
        .selection-card:hover .selection-icon {
            transform: scale(1.1) rotateY(10deg);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }
        
        .selection-card-title {
            font-size: 1.8rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            position: relative;
            z-index: 2;
        }
        
        .selection-card-desc {
            font-size: 1.1rem;
            opacity: 0.9;
            line-height: 1.7;
            position: relative;
            z-index: 2;
        }
        
        .back-btn {
            position: absolute;
            top: 120px;
            left: 2rem;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 0.8rem 1.5rem;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
            font-weight: 500;
        }
        
        .back-btn:hover {
            background: rgba(255, 255, 255, 0.25);
            color: white;
            text-decoration: none;
            transform: translateX(-5px);
        }
        
        .floating-elements {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            pointer-events: none;
            z-index: 1;
        }
        
        .floating-element {
            position: absolute;
            color: rgba(255, 255, 255, 0.1);
            font-size: 2.5rem;
            animation: float 6s ease-in-out infinite;
        }
        
        .floating-element:nth-child(1) { 
            top: 15%; left: 8%; 
            animation-delay: 0s; 
            font-size: 3rem;
        }
        .floating-element:nth-child(2) { 
            top: 65%; right: 12%; 
            animation-delay: 2s; 
            font-size: 2rem;
        }
        .floating-element:nth-child(3) { 
            bottom: 25%; left: 15%; 
            animation-delay: 4s; 
            font-size: 2.5rem;
        }
        .floating-element:nth-child(4) { 
            top: 35%; right: 20%; 
            animation-delay: 1s; 
            font-size: 1.8rem;
        }
        .floating-element:nth-child(5) { 
            bottom: 15%; right: 8%; 
            animation-delay: 3s; 
            font-size: 2.2rem;
        }
        
        @keyframes float {
            0%, 100% { 
                transform: translateY(0px) rotate(0deg); 
                opacity: 0.1;
            }
            50% { 
                transform: translateY(-25px) rotate(180deg); 
                opacity: 0.2;
            }
        }
        
        .selection-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            backdrop-filter: blur(5px);
        }
        
        .patient-badge {
            background: rgba(76, 175, 80, 0.3);
        }
        
        .health-center-badge {
            background: rgba(21, 155, 189, 0.3);
        }
        
        .administrator-badge {
            background: rgba(255, 107, 107, 0.3);
        }
        
        @media (max-width: 768px) {
            .selection-title {
                font-size: 2.5rem;
            }
            
            .selection-subtitle {
                font-size: 1.1rem;
            }
            
            .selection-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
                margin-top: 2rem;
            }
            
            .selection-card {
                padding: 2.5rem 2rem;
            }
            
            .back-btn {
                top: 90px;
                left: 1rem;
                padding: 0.6rem 1.2rem;
                font-size: 0.9rem;
            }
            
            .floating-element {
                font-size: 1.5rem !important;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <div class="brand-container">
                    <div class="brand-icon">
                        <i class="fas fa-hospital-symbol"></i>
                    </div>
                    <div class="brand-text">
                        <span class="brand-name">HomeCare Plus</span>
                        <span class="brand-tagline">Healthcare Excellence</span>
                    </div>
                </div>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link btn btn-outline-primary btn-sm ms-2 download-btn" href="/app-debug.apk" download="HomeCare-Plus-App.apk">
                            <i class="fas fa-download"></i>
                            <span>Download App</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn btn-primary btn-sm ms-2 cta-btn" href="/register">
                            <i class="fas fa-rocket"></i>
                            <span>Get Started</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Selection Hero Section -->
    <section class="selection-hero">
        <div class="floating-elements">
            <div class="floating-element">
                <i class="fas fa-user-md"></i>
            </div>
            <div class="floating-element">
                <i class="fas fa-hospital"></i>
            </div>
            <div class="floating-element">
                <i class="fas fa-heartbeat"></i>
            </div>
            <div class="floating-element">
                <i class="fas fa-stethoscope"></i>
            </div>
            <div class="floating-element">
                <i class="fas fa-pills"></i>
            </div>
        </div>
        

        
        <div class="container">
            <div class="selection-content">
                <h1 class="selection-title" data-aos="fade-up">Choose Your Path</h1>
                <p class="selection-subtitle" data-aos="fade-up" data-aos-delay="200">
                    Select your role to access the right tools and features designed specifically for your healthcare journey. 
                    Each path is tailored to provide the best experience for your unique needs.
                </p>
                
                <div class="selection-grid">
                    <a href="/app-features" class="selection-card patient" data-aos="fade-up" data-aos-delay="300">
                        <div class="selection-badge patient-badge">Popular</div>
                        <div class="selection-icon">
                            <i class="fas fa-mobile-screen-button"></i>
                        </div>
                        <h3 class="selection-card-title">I am a Patient</h3>
                        <p class="selection-card-desc">
                            Access our comprehensive mobile app features including appointment booking, 
                            healthcare provider discovery, secure messaging with doctors, and personal health management tools.
                        </p>
                    </a>
                    
                    <a href="/login" class="selection-card health-center" data-aos="fade-up" data-aos-delay="400">
                        <div class="selection-badge health-center-badge">Professional</div>
                        <div class="selection-icon">
                            <i class="fas fa-hospital-user"></i>
                        </div>
                        <h3 class="selection-card-title">We are a Health Center</h3>
                        <p class="selection-card-desc">
                            Manage your medical facility with our comprehensive dashboard. Handle patient appointments, 
                            communicate with patients, manage staff schedules, and streamline your healthcare operations.
                        </p>
                    </a>
                    
                    <a href="http://localhost:4000" class="selection-card administrator" data-aos="fade-up" data-aos-delay="500">
                        <div class="selection-badge administrator-badge">Advanced</div>
                        <div class="selection-icon">
                            <i class="fas fa-user-gear"></i>
                        </div>
                        <h3 class="selection-card-title">Administrator</h3>
                        <p class="selection-card-desc">
                            Access the comprehensive admin dashboard to oversee the entire platform, manage user accounts, 
                            monitor system performance, configure settings, and ensure platform security.
                        </p>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="footer-brand">
                        <i class="fas fa-heartbeat"></i>
                        <span>HomeCare Plus</span>
                    </div>
                    <p class="footer-text">
                        Your trusted partner for modern medical management.
                    </p>
                </div>
                <div class="col-lg-6 text-lg-end">
                    <div class="footer-links">
                        <a href="/">Home</a>
                        <a href="/register">Get Started</a>
                        <a href="/login">Login</a>
                        <a href="/selection">Choose Your Path</a>
                    </div>
                </div>
            </div>
            <hr class="footer-divider">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <p class="footer-copyright">
                        © 2024 HomeCare Plus. All rights reserved.
                    </p>
                </div>
                <div class="col-lg-6 text-lg-end">
                    <div class="footer-social">
                        <a href="#"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-linkedin"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <script>
        // Initialize AOS
        AOS.init({
            duration: 1000,
            once: true
        });

        // Navbar scroll effect
        window.addEventListener('scroll', function() {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('navbar-scrolled');
            } else {
                navbar.classList.remove('navbar-scrolled');
            }
        });
    </script>
</body>
</html> 