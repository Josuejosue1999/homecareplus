<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mobile App Features - HomeCare Plus</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/landing.css">
    
    <style>
        .hero-app-section {
            background: linear-gradient(135deg, #159BBD 0%, #0D5C73 50%, #0A4A5E 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        
        .hero-app-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
        }
        
        .hero-app-content {
            position: relative;
            z-index: 2;
            color: white;
            padding: 80px 0;
        }
        
        .app-hero-title {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }
        
        .app-hero-subtitle {
            font-size: 1.3rem;
            margin-bottom: 2rem;
            opacity: 0.95;
            line-height: 1.7;
        }
        
        .app-download-buttons {
            display: flex;
            gap: 1rem;
            margin-bottom: 3rem;
        }
        
        .download-btn-pro {
            display: flex;
            align-items: center;
            gap: 1rem;
            background: rgba(255, 255, 255, 0.95);
            color: #159BBD;
            padding: 1rem 2rem;
            border-radius: 15px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            border: 2px solid rgba(255, 255, 255, 0.3);
            backdrop-filter: blur(10px);
        }
        
        .download-btn-pro:hover {
            background: white;
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            color: #0D5C73;
            text-decoration: none;
        }
        
        .download-btn-pro i {
            font-size: 1.5rem;
        }
        
        .app-features-showcase {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            margin-top: 3rem;
        }
        
        .feature-highlight {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 2rem;
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }
        
        .feature-highlight:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-5px);
        }
        
        .feature-highlight h4 {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            font-weight: 600;
        }
        
        .feature-highlight p {
            font-size: 1rem;
            opacity: 0.9;
            line-height: 1.6;
        }
        
        .app-screenshots-hero {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            perspective: 1000px;
        }
        
        .hero-screenshot {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 25px;
            padding: 1.5rem;
            backdrop-filter: blur(10px);
            transition: all 0.4s ease;
            border: 1px solid rgba(255, 255, 255, 0.2);
            height: 450px;
        }
        
        .hero-screenshot:hover {
            transform: rotateY(10deg) translateZ(20px);
            background: rgba(255, 255, 255, 0.15);
        }
        
        .hero-screenshot:nth-child(2):hover {
            transform: rotateY(-5deg) translateZ(30px) scale(1.05);
        }
        
        .hero-screenshot img {
            width: 100%;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
        
        .detailed-features-section {
            padding: 5rem 0;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            position: relative;
        }
        
        .detailed-features-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="%23159BBD" stroke-width="0.5" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
            opacity: 0.3;
        }
        
        .features-container {
            position: relative;
            z-index: 2;
        }
        
        .feature-main-showcase {
            background: white;
            border-radius: 25px;
            padding: 3rem;
            box-shadow: 0 20px 60px rgba(21, 155, 189, 0.1);
            border: 1px solid rgba(21, 155, 189, 0.1);
            margin-bottom: 3rem;
        }
        
        .feature-images-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        .feature-image-container {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(21, 155, 189, 0.2);
            height: 300px;
        }
        
        .feature-image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: all 0.3s ease;
        }
        
        .feature-image-container:hover img {
            transform: scale(1.05);
        }
        
        .feature-overlay-info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(21, 155, 189, 0.9));
            color: white;
            padding: 2rem;
            transform: translateY(100%);
            transition: all 0.3s ease;
        }
        
        .feature-image-container:hover .feature-overlay-info {
            transform: translateY(0);
        }
        
        .feature-content-detailed {
            padding: 2rem 0;
        }
        
        .feature-benefits {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }
        
        .benefit-item {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 1.5rem;
            background: rgba(21, 155, 189, 0.05);
            border-radius: 15px;
            border-left: 4px solid #159BBD;
            transition: all 0.3s ease;
        }
        
        .benefit-item:hover {
            background: rgba(21, 155, 189, 0.1);
            transform: translateX(10px);
        }
        
        .benefit-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #159BBD, #0D5C73);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        
        .benefit-text h5 {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #0D5C73;
        }
        
        .benefit-text p {
            font-size: 0.95rem;
            color: #666;
            line-height: 1.5;
            margin: 0;
        }
        
        @media (max-width: 768px) {
            .app-hero-title {
                font-size: 2.5rem;
            }
            
            .app-features-showcase {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
            
            .app-screenshots-hero {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            
            .app-download-buttons {
                flex-direction: column;
                align-items: center;
            }
            
            .download-btn-pro {
                width: 100%;
                max-width: 300px;
                justify-content: center;
            }
            
            .feature-benefits {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
