        function updateClinicButtons(clinicId, isApproved) {
            // Update buttons in the table view
            const tableRow = document.querySelector(`tr[data-clinic-id="${clinicId}"]`);
            if (tableRow) {
                const actionCell = tableRow.querySelector('.actions-cell');
                if (actionCell) {
                    const buttonContainer = actionCell.querySelector('.action-buttons');
                    if (buttonContainer) {
                        // Find and update the approve/unapprove buttons
                        const approveBtn = buttonContainer.querySelector('.btn-approve');
                        const unapproveBtn = buttonContainer.querySelector('.btn-unapprove');
                        
                        if (isApproved) {
                            // Clinic is now approved, show unapprove button
                            if (approveBtn) {
                                approveBtn.outerHTML = `
                                    <button class="btn-action btn-unapprove" onclick="unapproveClinic('${clinicId}')">
                                        <i class="fas fa-times"></i>
                                        Unapprove
                                    </button>
                                `;
                            }
                        } else {
                            // Clinic is now unapproved, show approve button
                            if (unapproveBtn) {
                                unapproveBtn.outerHTML = `
                                    <button class="btn-action btn-approve" onclick="approveClinic('${clinicId}')">
                                        <i class="fas fa-check"></i>
                                        Approve
                                    </button>
                                `;
                            }
                        }
                    }
                }
            }

            // Update the clinic data in memory
            const clinicIndex = clinicsData.findIndex(clinic => clinic.id === clinicId);
            if (clinicIndex !== -1) {
                clinicsData[clinicIndex].verified = isApproved;
                clinicsData[clinicIndex].isVerified = isApproved;
            }
        }

        function filterClinics() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const filteredClinics = clinicsData.filter(clinic => 
                (clinic.name || clinic.clinicName).toLowerCase().includes(searchTerm) ||
                clinic.email.toLowerCase().includes(searchTerm) ||
                (clinic.address || clinic.location || '').toLowerCase().includes(searchTerm)
            );
            displayClinics(filteredClinics);
        }

