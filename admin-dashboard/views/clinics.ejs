                console.error('💥 Error fetching clinic details:', error);
                
                if (typeof Swal !== 'undefined') {
                    Swal.close();
                    await Swal.fire({
                        title: 'Error!',
                        text: 'An error occurred while fetching clinic details.',
                        icon: 'error',
                        confirmButtonColor: '#159BBD'
                    });
                } else {
                    alert('An error occurred while fetching clinic details.');
                }
            }
        }

        function showClinicDetailsModal(clinic) {
            console.log('📋 Showing clinic details modal for:', clinic);
            
            // Navigate to clinic's full profile page in the admin dashboard
            const clinicProfileUrl = `/clinic-profile/${clinic.id}`;
            
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'View Clinic Profile',
                    html: `
                        <div style="text-align: left; margin: 1rem 0;">
                            <h5 style="color: var(--primary-color); margin-bottom: 1rem;">
                                <i class="fas fa-hospital-alt me-2"></i>
                                ${clinic.clinicName || clinic.name || 'Clinic Name'}
                            </h5>
                            <div style="background: #f8f9fa; padding: 1rem; border-radius: 10px; margin-bottom: 1rem;">
                                <p><strong><i class="fas fa-envelope me-2"></i>Email:</strong> ${clinic.email || 'Not provided'}</p>
                                <p><strong><i class="fas fa-map-marker-alt me-2"></i>Address:</strong> ${clinic.address || clinic.location || 'Not provided'}</p>
                                <p><strong><i class="fas fa-phone me-2"></i>Phone:</strong> ${clinic.phone || clinic.googlePhoneNumber || 'Not provided'}</p>
                                <p><strong><i class="fas fa-star me-2"></i>Rating:</strong> ${clinic.rating || 0}/5</p>
                                <p><strong><i class="fas fa-check-circle me-2"></i>Status:</strong> 
                                    <span style="color: ${clinic.verified ? 'green' : 'orange'};">
                                        ${clinic.verified ? 'Verified' : 'Pending'}
                                    </span>
                                </p>
                            </div>
                            <p style="color: #666; font-size: 0.9rem;">
                                <i class="fas fa-info-circle me-1"></i>
                                View the complete clinic profile with all details and photos
                            </p>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonColor: '#159BBD',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fas fa-external-link-alt me-2"></i>View Full Profile',
                    cancelButtonText: 'Close',
                    width: '600px'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.open(clinicProfileUrl, '_blank');
                    }
                });
            } else {
                // Fallback for browsers without SweetAlert2
                const confirmed = confirm(`View full profile for ${clinic.clinicName || clinic.name}?\n\nThis will open in a new tab.`);
                if (confirmed) {
                    window.open(clinicProfileUrl, '_blank');
                }
            }
        }

        // Add comprehensive debug logging
        console.log('🔧 DEBUG: Script loaded, setting up event listeners...');
        
        // Test button click events
        function testButtonClicks() {
            console.log('🔧 DEBUG: Testing if buttons are clickable...');
            
            // Wait for DOM to be ready
            setTimeout(() => {
                const buttons = document.querySelectorAll('.btn-action');
                console.log('🔧 DEBUG: Found buttons:', buttons.length);
                
                buttons.forEach((button, index) => {
                    console.log(`🔧 DEBUG: Button ${index}:`, {
                        class: button.className,
                        onclick: button.getAttribute('onclick'),
                        text: button.textContent.trim()
                    });
                });
                
                // Test if functions exist in global scope
                console.log('🔧 DEBUG: Global function availability:', {
                    viewClinic: typeof window.viewClinic,
                    approveClinic: typeof window.approveClinic,
                    unapproveClinic: typeof window.unapproveClinic,
                    rejectClinic: typeof window.rejectClinic,
                    loadClinics: typeof window.loadClinics
                });
            }, 1000);
        }
        
        // Check if functions exist before assigning
        console.log('🔧 DEBUG: Function types before assignment:', {
            viewClinic: typeof viewClinic,
            approveClinic: typeof approveClinic,
            unapproveClinic: typeof unapproveClinic,
            rejectClinic: typeof rejectClinic,
            loadClinics: typeof loadClinics
        });
        
        // Verify functions are available globally
        window.viewClinic = viewClinic;
        window.approveClinic = approveClinic;
        window.unapproveClinic = unapproveClinic;
        window.rejectClinic = rejectClinic;
        window.loadClinics = loadClinics;
        
        console.log('🔧 DEBUG: Functions added to window:', {
            viewClinic: typeof window.viewClinic,
            approveClinic: typeof window.approveClinic,
            unapproveClinic: typeof window.unapproveClinic,
            rejectClinic: typeof window.rejectClinic,
            loadClinics: typeof window.loadClinics
        });

        // Load clinics on page load
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🔧 DEBUG: DOMContentLoaded event fired');
            loadClinics();
            testButtonClicks();
        });

        // Logout function with confirmation popup
        function handleLogout() {
            Swal.fire({
                title: 'Are you sure you want to log out?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, log out',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/logout'; // Redirect to logout endpoint
                }
            });
        }
    </script>
</body>
