<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - HomeCare Plus</title>
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <!-- Animated Background -->
    <div class="animated-bg"></div>
    
    <!-- Floating Particles -->
    <div class="particles" id="particles"></div>

    <div class="dashboard-container">
        <!-- Sidebar -->
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-heartbeat"></i>
                    <span>HomeCare Plus</span>
                </div>
                <div class="sidebar-user">
                    <div class="user-avatar">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div class="user-info">
                        <h6>Admin System</h6>
                        <span>Super Administrator</span>
                    </div>
                </div>
            </div>
            
            <nav class="sidebar-nav">
                <div class="nav-item active">
                    <a href="/" class="nav-link">
                        <i class="fas fa-chart-line"></i>
                        <span>Dashboard</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/clinics" class="nav-link clinics-link">
                        <i class="fas fa-hospital"></i>
                        <span>Healthcare Centers</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/suggestions" class="nav-link">
                        <i class="fas fa-lightbulb"></i>
                        <span>Suggestions</span>
                    </a>
                </div>
            </nav>
            
            <div class="sidebar-footer">
                <div class="nav-item">
                    <a href="#" class="nav-link" onclick="handleLogout(); return false;">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Header -->
            <div class="top-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1>Dashboard Overview</h1>
                </div>
                <div class="header-right">
                    <div class="search-container">
                        <input type="text" class="search-input" placeholder="Search...">
                        <i class="fas fa-search search-icon"></i>
                    </div>
                    <div class="user-menu" id="userMenu">
                        <div class="user-avatar-small">
                            <i class="fas fa-user"></i>
                        </div>
                        <span>Admin</span>
                    </div>
                </div>
            </div>

            <!-- Dashboard Content -->
            <div class="dashboard-content">
                <!-- Welcome Section -->
                <div class="row">
                    <div class="col-12">
                        <div class="content-card fade-in-up glass-effect">
                            <div class="card-header">
                                <h5>
                                    <i class="fas fa-wave-square"></i>
                                    Welcome to HomeCare Plus Admin
                                </h5>
                                <div class="card-actions">
                                    <span class="text-primary">Last login: Today, 9:30 AM</span>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="row">
                                    <div class="col-md-8">
                                        <p class="text-light mb-3">Good morning! Here's what's happening in your healthcare platform today.</p>
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <div class="metric-item">
                                                    <i class="fas fa-calendar-check text-success"></i>
                                                    <span>23 appointments scheduled today</span>
                                                </div>
                                            </div>
                                            <div class="col-sm-6">
                                                <div class="metric-item">
                                                    <i class="fas fa-hospital text-info"></i>
                                                    <span>3 new clinics pending approval</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-center">
                                        <div class="dashboard-illustration">
                                            <i class="fas fa-heartbeat text-primary" style="font-size: 4rem; opacity: 0.3;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Statistics Cards -->
                <div class="row">
                    <div class="col-md-3 col-sm-6 fade-in-up">
                        <div class="stat-card glass-effect">
                            <div class="stat-icon users">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="stat-content">
                                <h3 id="totalUsers">1,248</h3>
                                <p>Total Users</p>
                                <div class="stat-change positive">
                                    <i class="fas fa-arrow-up"></i>
                                    <span>+12.5% this month</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-3 col-sm-6 fade-in-up">
                        <div class="stat-card glass-effect">
                            <div class="stat-icon clinics">
                                <i class="fas fa-hospital"></i>
                            </div>
                            <div class="stat-content">
                                <h3 id="totalClinics">36</h3>
                                <p>Healthcare Centers</p>
                                <div class="stat-change positive">
                                    <i class="fas fa-arrow-up"></i>
                                    <span>+28.6% this month</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-3 col-sm-6 fade-in-up">
                        <div class="stat-card glass-effect">
                            <div class="stat-icon appointments">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <div class="stat-content">
                                <h3 id="totalAppointments">892</h3>
                                <p>Appointments</p>
                                <div class="stat-change positive">
                                    <i class="fas fa-arrow-up"></i>
                                    <span>+8.3% this month</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-3 col-sm-6 fade-in-up">
                        <div class="stat-card glass-effect">
                            <div class="stat-icon revenue">
                                <i class="fas fa-dollar-sign"></i>
                            </div>
                            <div class="stat-content">
                                <h3 id="totalRevenue">$45,678</h3>
                                <p>Monthly Revenue</p>
                                <div class="stat-change positive">
                                    <i class="fas fa-arrow-up"></i>
                                    <span>+15.2% this month</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts and Analytics -->
                <div class="row">
                    <div class="col-lg-8">
                        <div class="content-card slide-in-left glass-effect">
                            <div class="card-header">
                                <h5>
                                    <i class="fas fa-chart-area"></i>
                                    Platform Growth Analytics
                                </h5>
                                <div class="card-actions">
                                    <button class="chart-btn active" data-chart="users">Users</button>
                                    <button class="chart-btn" data-chart="clinics">Clinics</button>
                                    <button class="chart-btn" data-chart="appointments">Appointments</button>
                                    <button class="chart-btn" data-chart="revenue">Revenue</button>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="chart-container">
                                    <canvas id="growthChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-4">
                        <div class="content-card slide-in-right glass-effect">
                            <div class="card-header">
                                <h5>
                                    <i class="fas fa-clock"></i>
                                    Recent Activities
                                </h5>
                                <div class="card-actions">
                                    <a href="#" class="text-primary">View All</a>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="activity-list">
                                    <div class="activity-item">
                                        <div class="activity-icon clinic">
                                            <i class="fas fa-hospital"></i>
                                        </div>
                                        <div class="activity-content">
                                            <h6>New Clinic Registration</h6>
                                            <p>Zindiro Medical Center submitted registration documents</p>
                                            <div class="activity-time">
                                                <i class="far fa-clock"></i>
                                                <span>2 hours ago</span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="activity-item">
                                        <div class="activity-icon appointment">
                                            <i class="fas fa-calendar-check"></i>
                                        </div>
                                        <div class="activity-content">
                                            <h6>Appointment Peak</h6>
                                            <p>15 new appointments booked in the last hour</p>
                                            <div class="activity-time">
                                                <i class="far fa-clock"></i>
                                                <span>3 hours ago</span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="activity-item">
                                        <div class="activity-icon user">
                                            <i class="fas fa-user-plus"></i>
                                        </div>
                                        <div class="activity-content">
                                            <h6>New Users Registered</h6>
                                            <p>8 new patients joined the platform</p>
                                            <div class="activity-time">
                                                <i class="far fa-clock"></i>
                                                <span>5 hours ago</span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="activity-item">
                                        <div class="activity-icon clinic">
                                            <i class="fas fa-check-circle"></i>
                                        </div>
                                        <div class="activity-content">
                                            <h6>Clinic Verification</h6>
                                            <p>King Faisal Hospital verification completed</p>
                                            <div class="activity-time">
                                                <i class="far fa-clock"></i>
                                                <span>8 hours ago</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions and System Status -->
                <div class="row">
                    <div class="col-lg-6">
                        <div class="content-card fade-in-up glass-effect">
                            <div class="card-header">
                                <h5>
                                    <i class="fas fa-bolt"></i>
                                    Quick Actions
                                </h5>
                            </div>
                            <div class="card-content">
                                <div class="quick-actions-grid">
                                    <div class="action-item">
                                        <a href="/clinics" class="action-btn primary">
                                            <div class="action-icon">
                                            <i class="fas fa-hospital"></i>
                                            </div>
                                            <div class="action-content">
                                                <h6>Manage Clinics</h6>
                                                <p>Review and approve healthcare centers</p>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="action-item">
                                        <a href="/suggestions" class="action-btn warning">
                                            <div class="action-icon">
                                                <i class="fas fa-lightbulb"></i>
                                            </div>
                                            <div class="action-content">
                                                <h6>View Suggestions</h6>
                                                <p>Review user feedback and suggestions</p>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="action-item">
                                        <button class="action-btn info" onclick="generateReport()">
                                            <div class="action-icon">
                                            <i class="fas fa-file-alt"></i>
                                            </div>
                                            <div class="action-content">
                                                <h6>Generate Report</h6>
                                                <p>Create detailed analytics reports</p>
                                            </div>
                                        </button>
                                    </div>
                                    <div class="action-item">
                                        <button class="action-btn success" onclick="viewAnalytics()">
                                            <div class="action-icon">
                                                <i class="fas fa-chart-bar"></i>
                                            </div>
                                            <div class="action-content">
                                                <h6>View Analytics</h6>
                                                <p>Monitor platform performance</p>
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-6">
                        <div class="content-card fade-in-up glass-effect">
                            <div class="card-header">
                                <h5>
                                    <i class="fas fa-server"></i>
                                    System Status
                                </h5>
                                <div class="card-actions">
                                    <span class="status-badge active">All Systems Operational</span>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="status-list">
                                    <div class="status-item">
                                        <div class="status-indicator success"></div>
                                        <span>Database Connection</span>
                                        <div class="status-value">99.9% uptime</div>
                                    </div>
                                    <div class="status-item">
                                        <div class="status-indicator success"></div>
                                        <span>Firebase Services</span>
                                        <div class="status-value">Operational</div>
                                    </div>
                                    <div class="status-item">
                                        <div class="status-indicator warning"></div>
                                        <span>Server Load</span>
                                        <div class="status-value">68% capacity</div>
                                    </div>
                                    <div class="status-item">
                                        <div class="status-indicator success"></div>
                                        <span>API Response Time</span>
                                        <div class="status-value">142ms avg</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/dashboard.js"></script>
    <script>
        // Quick Actions Functions
        function generateReport() {
            Swal.fire({
                title: 'Generate Report',
                text: 'Select the type of report you want to generate:',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Monthly Report',
                cancelButtonText: 'Weekly Report',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Success!', 'Monthly report is being generated...', 'success');
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    Swal.fire('Success!', 'Weekly report is being generated...', 'success');
                }
            });
        }

        function viewAnalytics() {
            Swal.fire({
                title: 'Analytics Dashboard',
                html: `
                    <div style="text-align: left; margin: 1rem 0;">
                        <h6>Platform Performance Overview:</h6>
                        <ul style="margin-left: 1rem;">
                            <li>Total Users: <strong>1,248</strong></li>
                            <li>Active Clinics: <strong>36</strong></li>
                            <li>Monthly Growth: <strong>+15.2%</strong></li>
                            <li>System Uptime: <strong>99.9%</strong></li>
                        </ul>
                    </div>
                `,
                icon: 'info',
                confirmButtonText: 'View Detailed Analytics',
                showCancelButton: true,
                cancelButtonText: 'Close'
            }).then((result) => {
                if (result.isConfirmed) {
                    // In a real application, you would navigate to a detailed analytics page
                    Swal.fire('Coming Soon!', 'Detailed analytics dashboard is under development.', 'info');
                }
            });
        }

        // Logout function
        function handleLogout() {
            Swal.fire({
                title: 'Logout Confirmation',
                text: 'Are you sure you want to logout?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Logout',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#159BBD'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Call logout API first
                    fetch('/api/admin/logout', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                    Swal.fire('Logged Out!', 'You have been successfully logged out.', 'success').then(() => {
                                window.location.href = '/login';
                            });
                        } else {
                            Swal.fire('Error', 'Failed to logout. Please try again.', 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Logout error:', error);
                        // Even if API call fails, redirect to login
                        window.location.href = '/login';
                    });
                }
            });
        }

        // Improved dashboard content positioning
        document.addEventListener('DOMContentLoaded', function() {
            // Add smooth scrolling for navigation
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth'
                        });
                    }
                });
            });

            // Optimize layout for better positioning
            const contentCards = document.querySelectorAll('.content-card');
            contentCards.forEach(card => {
                card.style.marginBottom = '1.5rem';
            });

            // Auto-adjust grid spacing
            const statCards = document.querySelectorAll('.stat-card');
            if (statCards.length > 0) {
                statCards.forEach(card => {
                    card.style.marginBottom = '1rem';
                });
            }

            // Ensure proper spacing between sections
            const rows = document.querySelectorAll('.row');
            rows.forEach(row => {
                row.style.marginBottom = '2rem';
            });

            // Improved responsive positioning
            function adjustLayout() {
                const screenWidth = window.innerWidth;
                const dashboardContent = document.querySelector('.dashboard-content');
                
                if (screenWidth < 768) {
                    dashboardContent.style.padding = '1rem';
                } else if (screenWidth < 1200) {
                    dashboardContent.style.padding = '1.5rem';
                } else {
                    dashboardContent.style.padding = '2rem';
                }
            }

            adjustLayout();
            window.addEventListener('resize', adjustLayout);
        });
    </script>

    <style>
        .metric-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
            padding: 10px;
            border-radius: 8px;
            background: rgba(21, 155, 189, 0.05);
        }

        .metric-item i {
            font-size: 1.2rem;
        }

        .metric-item span {
            font-size: 0.9rem;
            color: var(--text-light);
        }

        /* Enhanced Quick Actions Grid */
        .quick-actions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 1rem;
        }

        .action-item {
            transition: all 0.3s ease;
        }

        .action-item:hover {
            transform: translateY(-2px);
        }

        .action-btn {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1.5rem;
            border-radius: 12px;
            text-decoration: none;
            border: none;
            width: 100%;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(21, 155, 189, 0.2);
        }

        .action-btn:hover {
            box-shadow: 0 6px 20px rgba(21, 155, 189, 0.3);
            transform: translateY(-1px);
            color: white;
        }

        .action-btn.primary {
            background: linear-gradient(135deg, #159BBD, #0EA5E9);
        }

        .action-btn.warning {
            background: linear-gradient(135deg, #fd7e14, #f59e0b);
        }

        .action-btn.info {
            background: linear-gradient(135deg, #6f42c1, #8b5cf6);
        }

        .action-btn.success {
            background: linear-gradient(135deg, #28a745, #22c55e);
        }

        .action-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.2);
            flex-shrink: 0;
        }

        .action-icon i {
            font-size: 1.5rem;
            color: white;
        }

        .action-content {
            flex: 1;
            text-align: left;
        }

        .action-content h6 {
            margin: 0 0 0.5rem 0;
            font-size: 1.1rem;
            font-weight: 600;
            color: white;
        }

        .action-content p {
            margin: 0;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.4;
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .quick-actions-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            
            .action-btn {
                padding: 1rem;
                gap: 0.75rem;
            }
            
            .action-icon {
                width: 40px;
                height: 40px;
            }
            
            .action-icon i {
                font-size: 1.2rem;
        }
        }

        /* Action buttons are now handled by the enhanced grid styles above */

        .status-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .status-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
        }

        .status-indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .status-indicator.success {
            background: var(--success-color);
            box-shadow: 0 0 10px rgba(40, 167, 69, 0.3);
        }

        .status-indicator.warning {
            background: var(--warning-color);
            box-shadow: 0 0 10px rgba(255, 193, 7, 0.3);
        }

        .status-indicator.danger {
            background: var(--danger-color);
            box-shadow: 0 0 10px rgba(220, 53, 69, 0.3);
        }

        .status-item span {
            flex: 1;
            color: var(--text-dark);
            font-weight: 500;
        }

        .status-value {
            color: var(--text-light);
            font-size: 0.9rem;
        }
    </style>
</body>
</html> 