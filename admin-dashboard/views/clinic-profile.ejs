<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= clinic.name || clinic.clinicName %> - Detailed Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #159BBD;
            --secondary-color: #20c997;
            --accent-color: #fd7e14;
            --dark-color: #212529;
        }

        .clinic-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
        }

        .clinic-avatar {
            width: 120px;
            height: 120px;
            border-radius: 20px;
            border: 4px solid white;
            object-fit: cover;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .status-badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
        }

        .status-verified {
            background: rgba(32, 201, 151, 0.1);
            color: var(--secondary-color);
            border: 2px solid var(--secondary-color);
        }

        .status-pending {
            background: rgba(253, 126, 20, 0.1);
            color: var(--accent-color);
            border: 2px solid var(--accent-color);
        }

        .status-rejected {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
            border: 2px solid #dc3545;
        }

        .info-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border: 1px solid #f0f0f0;
        }

        .info-card h5 {
            color: var(--primary-color);
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .info-item {
            display: flex;
            align-items: center;
            margin-bottom: 0.8rem;
            padding: 0.5rem 0;
        }

        .info-item i {
            color: var(--primary-color);
            width: 20px;
            margin-right: 10px;
        }

        .facility-badge {
            background: rgba(21, 155, 189, 0.1);
            color: var(--primary-color);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            margin: 0.25rem;
            display: inline-block;
        }

        .rating-stars {
            color: #ffc107;
            margin-left: 10px;
        }

        .google-badge {
            background: #4285f4;
            color: white;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.7rem;
            margin-left: 10px;
        }

        .photo-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 1rem;
        }

        .photo-item {
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
            cursor: pointer;
        }

        .photo-item:hover {
            transform: scale(1.05);
        }

        .photo-item img {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }

        .action-buttons {
            position: sticky;
            bottom: 20px;
            background: white;
            padding: 1rem;
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            margin-top: 2rem;
        }

        .btn-custom {
            border-radius: 10px;
            padding: 12px 20px;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-approve { background: var(--secondary-color); color: white; }
        .btn-reject { background: #dc3545; color: white; }
        .btn-unapprove { background: var(--accent-color); color: white; }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .opening-hours {
            font-size: 0.9rem;
        }

        .opening-hours .day {
            display: flex;
            justify-content: space-between;
            padding: 0.3rem 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .reviews-section {
            max-height: 400px;
            overflow-y: auto;
        }

        .review-item {
            border-left: 3px solid var(--primary-color);
            padding: 1rem;
            margin-bottom: 1rem;
            background: #f8f9fa;
            border-radius: 0 10px 10px 0;
        }

        .review-rating {
            color: #ffc107;
            margin-bottom: 0.5rem;
        }

        .opening-hours .hour-item {
            padding: 0.5rem 0;
            border-bottom: 1px solid #eee;
        }
        
        .opening-hours .hour-item:last-child {
            border-bottom: none;
        }

        .review-text {
            font-style: italic;
            color: #555;
            line-height: 1.5;
            margin: 0.5rem 0;
        }

        .overall-rating {
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 10px;
        }

        .review-avatar {
            object-fit: cover;
        }
        
        .photo-item {
            position: relative;
            overflow: hidden;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            aspect-ratio: 4/3;
        }

        .photo-item:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 25px rgba(0,0,0,0.2);
        }

        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: all 0.3s ease;
        }

        .document-section {
            margin-top: 1rem;
        }

        .document-item {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            transition: all 0.3s ease;
        }

        .document-item:hover {
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

        .document-info h6 {
            margin-bottom: 0.5rem;
            color: var(--dark-color);
        }

        .document-details {
            margin-bottom: 0.5rem;
        }

        .document-actions .btn {
            min-width: 80px;
        }

        .document-empty {
            text-align: center;
            padding: 2rem;
            color: #6c757d;
        }

        .document-empty i {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }
    </style>
</head>
<body>
    <div class="clinic-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-2">
                    <% if (clinic.profileImageUrl || clinic.googlePhotos) { %>
                        <img src="<%= clinic.profileImageUrl || (clinic.googlePhotos && clinic.googlePhotos.length > 0 ? 
                            `https://maps.googleapis.com/maps/api/place/photo?maxwidth=400&photo_reference=${clinic.googlePhotos[0].photo_reference}&key=AIzaSyA1g-UDJcfQS_33U3Sysxe9g4zlAOnpS3g` : 
                            '/assets/default-hospital.png') %>" 
                             alt="<%= clinic.name || clinic.clinicName %>" 
                             class="clinic-avatar">
                <% } else { %>
                    <div class="clinic-avatar d-flex align-items-center justify-content-center" style="background: rgba(255,255,255,0.2);">
                            <i class="fas fa-hospital-alt fa-3x"></i>
                    </div>
                                <% } %>
                            </div>
                <div class="col-md-8">
                    <h1><%= clinic.name || clinic.clinicName %></h1>
                    <p class="lead mb-3"><%= clinic.about || clinic.description || 'Healthcare facility' %></p>
                    <div class="d-flex align-items-center">
                        <span class="status-badge status-<%= clinic.verified || clinic.isVerified ? 'verified' : (clinic.status === 'rejected' ? 'rejected' : 'pending') %>">
                            <%= clinic.verified || clinic.isVerified ? 'Verified' : (clinic.status === 'rejected' ? 'Rejected' : 'Pending') %>
                        </span>
                        <% if (clinic.isFromGooglePlaces) { %>
                            <span class="google-badge">
                                <i class="fab fa-google"></i> Google Places
                        </span>
                    <% } %>
                        <% if (clinic.googleRating) { %>
                            <span class="rating-stars">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <i class="fas fa-star<%= i <= Math.floor(clinic.googleRating) ? '' : (i === Math.ceil(clinic.googleRating) ? '-half-alt' : ' text-muted') %>"></i>
                                <% } %>
                                (<%= clinic.googleRating %>/5)
                                <% if (clinic.googleUserRatingsTotal) { %>
                                    - <%= clinic.googleUserRatingsTotal %> reviews
                                <% } %>
                        </span>
                        <% } %>
                    </div>
                </div>
                <div class="col-md-2 text-end">
                    <a href="/clinics" class="btn btn-light btn-custom">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <!-- Informations principales -->
            <div class="col-md-4">
        <div class="info-card">
                    <h5><i class="fas fa-info-circle"></i> General Information</h5>
                    
                    <% if (clinic.address || clinic.googleAddress) { %>
                    <div class="info-item">
                        <i class="fas fa-map-marker-alt"></i>
                        <span><%= clinic.address || clinic.googleAddress %></span>
            </div>
                            <% } %>
                    
                    <% if (clinic.phone || clinic.googlePhoneNumber) { %>
                    <div class="info-item">
                        <i class="fas fa-phone"></i>
                        <span><%= clinic.phone || clinic.googlePhoneNumber %></span>
                                </div>
                    <% } %>
                    
                    <% if (clinic.email) { %>
                    <div class="info-item">
                        <i class="fas fa-envelope"></i>
                        <span><%= clinic.email %></span>
        </div>
                    <% } %>
                    
                    <% if (clinic.googleWebsite || clinic.website) { %>
                    <div class="info-item">
                        <i class="fas fa-globe"></i>
                        <a href="<%= clinic.googleWebsite || clinic.website %>" target="_blank">Website</a>
            </div>
                            <% } %>
                    
                            <% if (clinic.createdAt) { %>
                    <div class="info-item">
                        <i class="fas fa-calendar-plus"></i>
                        <span>Added on <%= new Date(clinic.createdAt).toLocaleDateString('en-US') %></span>
                    </div>
                            <% } %>
                    
                    <% if (clinic.verifiedAt) { %>
                    <div class="info-item">
                        <i class="fas fa-check-circle"></i>
                        <span>Verified on <%= new Date(clinic.verifiedAt).toLocaleDateString('en-US') %></span>
                    </div>
                            <% } %>
        </div>

                <!-- Heures d'ouverture Google -->
                <% if (clinic.googleOpeningHours && clinic.googleOpeningHours.weekday_text) { %>
        <div class="info-card">
                    <h5><i class="fas fa-clock"></i> Opening Hours</h5>
                    <div class="opening-hours">
                        <% clinic.googleOpeningHours.weekday_text.forEach(day => { %>
                        <div class="day">
                            <span><%= day %></span>
            </div>
                        <% }) %>
            </div>
        </div>
        <% } %>
            </div>

            <!-- Services et installations -->
            <div class="col-md-8">
        <div class="info-card">
                    <h5><i class="fas fa-stethoscope"></i> Services and Facilities</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Medical Services</h6>
                            <% if (clinic.services && clinic.services.length > 0) { %>
                                <% clinic.services.forEach(service => { %>
                                    <span class="facility-badge"><%= service %></span>
                                <% }) %>
                            <% } else if (clinic.facilities && clinic.facilities.length > 0) { %>
                                <% clinic.facilities.forEach(facility => { %>
                                    <span class="facility-badge"><%= facility %></span>
                                <% }) %>
                            <% } else { %>
                                <span class="text-muted">No services specified</span>
                            <% } %>
            </div>
                        <div class="col-md-6">
                            <h6>Types of Care</h6>
                            <% if (clinic.googleTypes && clinic.googleTypes.length > 0) { %>
                                <% clinic.googleTypes.forEach(type => { %>
                                    <span class="facility-badge"><%= type.replace(/_/g, ' ').toUpperCase() %></span>
                                <% }) %>
                            <% } else { %>
                                <span class="text-muted">Types not specified</span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Documents téléchargés depuis le dashboard -->
                <% if (clinic.documents && (clinic.documents.certificate || clinic.documents.id || clinic.documents.additional)) { %>
                <div class="info-card">
                    <h5><i class="fas fa-cloud-upload-alt"></i> Documents Uploaded from Dashboard</h5>
                    <div class="alert alert-info mb-3">
                        <i class="fas fa-info-circle me-2"></i>
                        Documents uploaded by the hospital from their dashboard are displayed below. 
                        <strong>Current status:</strong> <%= clinic.documents ? 'Documents found' : 'No documents' %>
                    </div>
                    <!-- Certificate Document -->
                    <% if (clinic.documents.certificate) { %>
                    <div class="document-section">
                        <h6 class="text-primary mb-3">
                            <i class="fas fa-certificate me-2"></i>Hospital Certificate
                        </h6>
                        <% if (clinic.documents.certificate.fileName) { %>
                        <div class="document-item d-flex align-items-center justify-content-between p-3 border rounded mb-3">
                            <div class="document-info">
                                <h6 class="mb-1">
                                    <i class="fas fa-certificate text-primary me-2"></i>
                                    <%= clinic.documents.certificate.fileName %>
                                </h6>
                                <!-- Document details removed for cleaner UI -->
                        </div>
                            <div class="document-actions">
                                <% if (clinic.documents.certificate.fileUrl) { %>
                                <a href="<%= clinic.documents.certificate.fileUrl %>" target="_blank" class="btn btn-primary btn-sm">
                                    <i class="fas fa-external-link-alt"></i> View
                                </a>
                                <% } else if (clinic.documents.certificate.fileData) { %>
                                <button onclick="viewDocument('<%= clinic.documents.certificate.fileData %>', '<%= clinic.documents.certificate.fileName %>', '<%= clinic.documents.certificate.fileType %>')" 
                                        class="btn btn-primary btn-sm">
                                    <i class="fas fa-eye"></i> View
                                </button>
                                <% } %>
                    </div>
                </div>
                        <% } else { %>
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No certificate document uploaded yet.
                        </div>
                        <% } %>
                    </div>
                    <% } %>
                    
                    <!-- ID/Passport Document -->
                    <% if (clinic.documents.id) { %>
                    <div class="document-section mt-4">
                        <h6 class="text-success mb-3">
                            <i class="fas fa-id-card me-2"></i>ID/Passport Document
                        </h6>
                    <div class="document-section">
                        <% if (clinic.documents.id && clinic.documents.id.fileName) { %>
                        <div class="document-item d-flex align-items-center justify-content-between p-3 border rounded mb-3">
                            <div class="document-info">
                                <h6 class="mb-1">
                                    <i class="fas fa-id-card text-success me-2"></i>
                                    ID/Passport: <%= clinic.documents.id.fileName %>
                                </h6>
                                <!-- Document details removed for cleaner UI -->
                            </div>
                            <div class="document-actions">
                                <% if (clinic.documents.id.fileUrl) { %>
                                <a href="<%= clinic.documents.id.fileUrl %>" target="_blank" class="btn btn-success btn-sm">
                                    <i class="fas fa-external-link-alt"></i> View
                                </a>
                                <% } else if (clinic.documents.id.fileData) { %>
                                <button onclick="viewDocument('<%= clinic.documents.id.fileData %>', '<%= clinic.documents.id.fileName %>', '<%= clinic.documents.id.fileType %>')" 
                                        class="btn btn-success btn-sm">
                                    <i class="fas fa-eye"></i> View
                                </button>
                        <% } %>
                    </div>
                </div>
                        <% } else { %>
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No ID/Passport document uploaded yet.
                        </div>
                        <% } %>
                    </div>
                    <% } %>
                    
                    <!-- Additional Document -->
                    <% if (clinic.documents.additional) { %>
                    <div class="document-section mt-4">
                        <h6 class="text-info mb-3">
                            <i class="fas fa-file-medical me-2"></i>Additional Document
                        </h6>
                        <% if (clinic.documents.additional.fileName) { %>
                        <div class="document-item d-flex align-items-center justify-content-between p-3 border rounded mb-3">
                            <div class="document-info">
                                <h6 class="mb-1">
                                    <i class="fas fa-file-alt text-warning me-2"></i>
                                    Additional Document: <%= clinic.documents.additional.fileName %>
                                </h6>
                                <!-- Document details removed for cleaner UI -->
        </div>
                            <div class="document-actions">
                                <% if (clinic.documents.additional.fileUrl) { %>
                                <a href="<%= clinic.documents.additional.fileUrl %>" target="_blank" class="btn btn-warning btn-sm">
                                    <i class="fas fa-external-link-alt"></i> View
                                </a>
                                <% } else if (clinic.documents.additional.fileData) { %>
                                <button onclick="viewDocument('<%= clinic.documents.additional.fileData %>', '<%= clinic.documents.additional.fileName %>', '<%= clinic.documents.additional.fileType %>')" 
                                        class="btn btn-warning btn-sm">
                                    <i class="fas fa-eye"></i> View
                                </button>
                                <% } %>
            </div>
                        </div>
                        <% } else { %>
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No additional document uploaded yet.
                        </div>
                        <% } %>
                    </div>
                    <% } %>
                </div>
                <% } else { %>
                <!-- No documents section -->
                <div class="info-card">
                    <h5><i class="fas fa-cloud-upload-alt"></i> Documents Uploaded from Dashboard</h5>
                    <div class="alert alert-light text-center">
                        <i class="fas fa-file-upload fa-3x text-muted mb-3"></i>
                        <h6 class="text-muted">No Documents Uploaded Yet</h6>
                        <p class="text-muted mb-0">
                            This hospital hasn't uploaded any documents through their dashboard yet.
                            <br>
                            Documents will appear here once they upload them from their Setup section.
                        </p>
                    </div>
                </div>
                <% } %>

                <!-- Photos de la clinique -->
                <% 
                // Déterminer les photos à afficher (priorité aux photos enrichies)
                let photosToShow = [];
                if (clinic.googlePhotos && clinic.googlePhotos.length > 0) {
                    photosToShow = clinic.googlePhotos;
                } else if (clinic.googlePlaceDetails && clinic.googlePlaceDetails.photos && clinic.googlePlaceDetails.photos.length > 0) {
                    photosToShow = clinic.googlePlaceDetails.photos.map(photo => ({
                        photo_reference: photo.photo_reference,
                        url: `https://maps.googleapis.com/maps/api/place/photo?maxwidth=800&photo_reference=${photo.photo_reference}&key=AIzaSyA1g-UDJcfQS_33U3Sysxe9g4zlAOnpS3g`,
                        width: photo.width,
                        height: photo.height
                    }));
                }
            %>
            
                <% if (photosToShow.length > 0) { %>
                <div class="info-card">
                    <h5><i class="fas fa-images"></i> Facility Photos</h5>
                <div class="photo-gallery">
                        <% photosToShow.slice(0, 8).forEach((photo, index) => { %>
                        <div class="photo-item" onclick="openPhotoModal('<%= photo.photo_reference || photo.url %>')">
                            <img src="<%= photo.url || `https://maps.googleapis.com/maps/api/place/photo?maxwidth=400&photo_reference=${photo.photo_reference}&key=AIzaSyA1g-UDJcfQS_33U3Sysxe9g4zlAOnpS3g` %>" 
                                 alt="Photo of <%= clinic.name || clinic.clinicName %>" 
                                 loading="lazy"
                                 onerror="this.parentElement.style.display='none'">
                        </div>
                        <% }) %>
                    </div>
                    <% if (photosToShow.length > 8) { %>
                    <p class="text-center mt-3">
                        <small class="text-muted">+ <%= photosToShow.length - 8 %> other photos</small>
                    </p>
                            <% } %>
                        </div>
                <% } %>
                
                <!-- Informations supplémentaires Google Places -->
                <% if (clinic.isFromGooglePlaces && clinic.placeId) { %>
                <div class="info-card">
                    <h5><i class="fab fa-google"></i> Google Places Information</h5>
                    
                    <% if (clinic.googleRating) { %>
                    <div class="info-item">
                        <i class="fas fa-star text-warning"></i>
                        <span><strong>Google Rating:</strong> <%= clinic.googleRating %>/5 
                            <% if (clinic.googleUserRatingsTotal) { %>
                                (<%= clinic.googleUserRatingsTotal %> reviews)
                            <% } %>
                        </span>
                    </div>
                    <% } %>
                    
                    <% if (clinic.googleWebsite) { %>
                    <div class="info-item">
                        <i class="fas fa-globe"></i>
                        <span><strong>Website:</strong> <a href="<%= clinic.googleWebsite %>" target="_blank" rel="noopener"><%= clinic.googleWebsite %></a></span>
                </div>
                    <% } %>
                    
                    <% if (clinic.googleTypes && clinic.googleTypes.length > 0) { %>
                    <div class="info-item">
                        <i class="fas fa-tags"></i>
                        <span><strong>Categories:</strong></span>
                        <div class="mt-2">
                            <% clinic.googleTypes.slice(0, 5).forEach(type => { %>
                                <span class="facility-badge"><%= type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %></span>
                            <% }) %>
                        </div>
                </div>
            <% } %>
                    
                    <% if (clinic.googlePriceLevel !== null && clinic.googlePriceLevel !== undefined) { %>
                    <div class="info-item">
                        <i class="fas fa-dollar-sign"></i>
                        <span><strong>Price Level:</strong> 
                            <% for (let i = 0; i < clinic.googlePriceLevel; i++) { %>
                                $
                            <% } %>
                            <% for (let i = clinic.googlePriceLevel; i < 4; i++) { %>
                                <span class="text-muted">$</span>
                            <% } %>
                        </span>
        </div>
                    <% } %>
                </div>
                <% } %>

                <!-- Heures d'ouverture Google -->
                <% if (clinic.googleOpeningHours && clinic.googleOpeningHours.weekday_text && clinic.googleOpeningHours.weekday_text.length > 0) { %>
        <div class="info-card">
                    <h5><i class="fas fa-clock"></i> Opening Hours</h5>
                    <div class="opening-hours">
                        <% clinic.googleOpeningHours.weekday_text.forEach(dayText => { %>
                            <div class="hour-item">
                                <span><%= dayText %></span>
            </div>
                        <% }) %>
                    </div>
                    <% if (clinic.googleOpeningHours.open_now !== undefined) { %>
                    <div class="mt-3">
                        <span class="badge bg-<%= clinic.googleOpeningHours.open_now ? 'success' : 'danger' %>">
                            <%= clinic.googleOpeningHours.open_now ? 'Currently Open' : 'Currently Closed' %>
                        </span>
                    </div>
                    <% } %>
                </div>
                <% } %>

                <!-- Avis Google -->
                <% 
                // Déterminer les avis à afficher (priorité aux avis enrichis)
                let reviewsToShow = [];
                if (clinic.googleReviews && clinic.googleReviews.length > 0) {
                    reviewsToShow = clinic.googleReviews;
                } else if (clinic.googlePlaceDetails && clinic.googlePlaceDetails.reviews && clinic.googlePlaceDetails.reviews.length > 0) {
                    reviewsToShow = clinic.googlePlaceDetails.reviews;
                }
                %>
                
                <% if (reviewsToShow.length > 0) { %>
                <div class="info-card">
                    <h5><i class="fas fa-star"></i> Patient Reviews</h5>
                    <div class="reviews-section">
                        <% reviewsToShow.slice(0, 5).forEach(review => { %>
                <div class="review-item">
                            <div class="d-flex align-items-center mb-2">
                                <% if (review.profile_photo_url) { %>
                                <img src="<%= review.profile_photo_url %>" alt="<%= review.author_name %>" class="review-avatar me-2" style="width: 32px; height: 32px; border-radius: 50%;">
                                <% } %>
                                <div>
                                    <strong><%= review.author_name %></strong>
                        <div class="review-rating">
                            <% for (let i = 1; i <= 5; i++) { %>
                                            <i class="fas fa-star<%= i <= review.rating ? ' text-warning' : ' text-muted' %>"></i>
                            <% } %>
                        </div>
                    </div>
                </div>
                            <% if (review.text && review.text.trim()) { %>
                            <p class="review-text"><%= review.text %></p>
                            <% } %>
                            <small class="text-muted">
                                <% if (review.relative_time_description) { %>
                                    <%= review.relative_time_description %>
                                <% } else if (review.time) { %>
                                    <%= new Date(review.time * 1000).toLocaleDateString('en-US') %>
                                <% } %>
                            </small>
            </div>
                        <% }) %>
        </div>
                    
                    <% if (clinic.googleRating) { %>
                    <div class="mt-3 text-center">
                        <div class="overall-rating">
                            <h4 class="mb-1">
                                <%= clinic.googleRating %>/5 
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <i class="fas fa-star<%= i <= Math.round(clinic.googleRating) ? ' text-warning' : ' text-muted' %>" style="font-size: 0.9em;"></i>
        <% } %>
                            </h4>
                            <% if (clinic.googleUserRatingsTotal) { %>
                            <small class="text-muted">Based on <%= clinic.googleUserRatingsTotal %> Google reviews</small>
                            <% } %>
                        </div>
                    </div>
                    <% } %>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Boutons d'action -->
        <div class="action-buttons">
            <div class="row">
                <div class="col-md-12 text-center">
                    <% if (!clinic.verified && !clinic.isVerified && clinic.status !== 'rejected') { %>
                        <button onclick="approveClinic('<%= clinic.id %>')" class="btn btn-approve btn-custom me-3">
                            <i class="fas fa-check"></i> Approve
                </button>
                        <button onclick="rejectClinic('<%= clinic.id %>')" class="btn btn-reject btn-custom">
                            <i class="fas fa-times"></i> Reject
                        </button>
                    <% } else if (clinic.verified || clinic.isVerified) { %>
                        <button onclick="unapproveClinic('<%= clinic.id %>')" class="btn btn-unapprove btn-custom">
                            <i class="fas fa-undo"></i> Remove Approval
                        </button>
                    <% } else if (clinic.status === 'rejected') { %>
                        <button onclick="approveClinic('<%= clinic.id %>')" class="btn btn-approve btn-custom">
                            <i class="fas fa-check"></i> Approve Anyway
                </button>
            <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal pour les photos -->
    <div class="modal fade" id="photoModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Facility Photo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="modalPhoto" src="" class="img-fluid" alt="Photo">
                </div>
            </div>
        </div>
    </div>

    <!-- Modal pour les documents -->
    <div class="modal fade" id="documentModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="documentModalTitle">Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <div id="documentContent">
                        <!-- Le contenu sera inséré ici -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="downloadDocument">
                        <i class="fas fa-download"></i> Download
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function openPhotoModal(photoReferenceOrUrl) {
            const modalPhoto = document.getElementById('modalPhoto');
            
            // Si c'est déjà une URL complète, l'utiliser directement
            if (photoReferenceOrUrl.startsWith('http')) {
                modalPhoto.src = photoReferenceOrUrl;
            } else {
                // Sinon, construire l'URL avec la référence de photo
                modalPhoto.src = `https://maps.googleapis.com/maps/api/place/photo?maxwidth=800&photo_reference=${photoReferenceOrUrl}&key=AIzaSyA1g-UDJcfQS_33U3Sysxe9g4zlAOnpS3g`;
            }
            
            const modal = new bootstrap.Modal(document.getElementById('photoModal'));
            modal.show();
        }

        function viewDocument(fileData, fileName, fileType) {
            const modalTitle = document.getElementById('documentModalTitle');
            const documentContent = document.getElementById('documentContent');
            const downloadButton = document.getElementById('downloadDocument');
            
            modalTitle.textContent = fileName;
            
            // Vérifier si les données contiennent déjà le préfixe data URL
            let dataUrl;
            if (fileData.startsWith('data:')) {
                // Les données contiennent déjà le préfixe data URL
                dataUrl = fileData;
            } else {
                // Construire l'URL data avec le préfixe
                dataUrl = `data:${fileType};base64,${fileData}`;
            }
            
            // Vérifier si c'est une image ou un PDF
            if (fileType.startsWith('image/')) {
                documentContent.innerHTML = `
                    <img src="${dataUrl}" 
                         class="img-fluid" 
                         alt="${fileName}" 
                         style="max-width: 100%; height: auto;">
                `;
            } else if (fileType === 'application/pdf') {
                documentContent.innerHTML = `
                    <embed src="${dataUrl}" 
                           type="application/pdf" 
                           width="100%" 
                           height="600px" 
                           style="border: 1px solid #ddd;">
                `;
            } else {
                documentContent.innerHTML = `
                    <div class="alert alert-info">
                        <i class="fas fa-file fa-3x mb-3"></i>
                        <h5>${fileName}</h5>
                        <p>This document type cannot be previewed directly. Use the download button to view it.</p>
                    </div>
                `;
            }
            
            // Configurer le bouton de téléchargement
            downloadButton.onclick = function() {
                downloadDocument(fileData, fileName, fileType);
            };
            
            const modal = new bootstrap.Modal(document.getElementById('documentModal'));
            modal.show();
        }

        function downloadDocument(fileData, fileName, fileType) {
            // Extraire les données base64 si le fileData contient le préfixe data URL
            let base64Data;
            if (fileData.startsWith('data:')) {
                // Extraire la partie base64 après la virgule
                base64Data = fileData.split(',')[1];
            } else {
                // Utiliser directement les données
                base64Data = fileData;
            }
            
            const blob = base64ToBlob(base64Data, fileType);
            const url = URL.createObjectURL(blob);
            
            const a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function base64ToBlob(base64, mimeType) {
            const byteCharacters = atob(base64);
            const byteNumbers = new Array(byteCharacters.length);
            
            for (let i = 0; i < byteCharacters.length; i++) {
                byteNumbers[i] = byteCharacters.charCodeAt(i);
            }
            
            const byteArray = new Uint8Array(byteNumbers);
            return new Blob([byteArray], { type: mimeType });
        }

        async function approveClinic(clinicId) {
                const result = await Swal.fire({
                title: 'Approve this clinic?',
                text: 'This action will approve the clinic and make it visible to patients.',
                    icon: 'question',
                    showCancelButton: true,
                confirmButtonColor: '#20c997',
                cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, approve',
                    cancelButtonText: 'Cancel'
                });

                if (result.isConfirmed) {
                try {
                    const response = await fetch(`/api/clinics/${clinicId}/approve`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    if (response.ok) {
                        Swal.fire('Approved!', 'The clinic has been approved successfully.', 'success')
                            .then(() => window.location.reload());
                    } else {
                        throw new Error('Error during approval');
                }
            } catch (error) {
                    Swal.fire('Error', 'Unable to approve the clinic.', 'error');
                }
            }
        }

        async function unapproveClinic(clinicId) {
                const result = await Swal.fire({
                title: 'Remove approval?',
                text: 'This clinic will return to "Pending" status.',
                    icon: 'warning',
                    showCancelButton: true,
                confirmButtonColor: '#fd7e14',
                    cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, remove',
                    cancelButtonText: 'Cancel'
                });

                if (result.isConfirmed) {
                try {
                    const response = await fetch(`/api/clinics/${clinicId}/unapprove`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    if (response.ok) {
                        Swal.fire('Modified!', 'The approval has been removed.', 'info')
                            .then(() => window.location.reload());
                    } else {
                        throw new Error('Error during removal');
                    }
                } catch (error) {
                    Swal.fire('Error', 'Unable to remove the approval.', 'error');
                }
            }
        }

        async function rejectClinic(clinicId) {
            const { value: reason } = await Swal.fire({
                title: 'Reject this clinic',
                input: 'textarea',
                inputLabel: 'Reason for rejection',
                inputPlaceholder: 'Explain why this clinic is being rejected...',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Reject',
                cancelButtonText: 'Cancel',
                inputValidator: (value) => {
                    if (!value) return 'You must specify a reason';
                }
            });

            if (reason) {
                try {
                    const response = await fetch(`/api/clinics/${clinicId}/reject`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason })
                    });

                    if (response.ok) {
                        Swal.fire('Rejected!', 'The clinic has been rejected.', 'error')
                            .then(() => window.location.reload());
                    } else {
                        throw new Error('Error during rejection');
                }
            } catch (error) {
                    Swal.fire('Error', 'Unable to reject the clinic.', 'error');
                }
            }
        }
    </script>
</body>
</html> 