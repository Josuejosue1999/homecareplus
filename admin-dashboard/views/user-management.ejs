<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management - HomeCare Plus</title>
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <!-- Animated Background -->
    <div class="animated-bg"></div>
    
    <!-- Floating Particles -->
    <div class="particles" id="particles"></div>

    <div class="dashboard-container">
        <!-- Sidebar -->
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <i class="fas fa-heartbeat"></i>
                    <span>HomeCare Plus</span>
                </div>
                <div class="sidebar-user">
                    <div class="user-avatar">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div class="user-info">
                        <h6>Admin System</h6>
                        <span>Super Administrator</span>
                    </div>
                </div>
            </div>
            
            <nav class="sidebar-nav">
                <div class="nav-item">
                    <a href="/" class="nav-link">
                        <i class="fas fa-chart-line"></i>
                        <span>Dashboard</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/clinics" class="nav-link">
                        <i class="fas fa-hospital"></i>
                        <span>Healthcare Centers</span>
                    </a>
                </div>
                <div class="nav-item active">
                    <a href="/user-management" class="nav-link">
                        <i class="fas fa-users-cog"></i>
                        <span>User Management</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/settings" class="nav-link">
                        <i class="fas fa-cogs"></i>
                        <span>Settings</span>
                    </a>
                </div>
            </nav>
            
            <div class="sidebar-footer">
                <div class="nav-item">
                    <a href="#" class="nav-link" onclick="handleLogout(); return false;">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Header -->
            <div class="top-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1>User Management</h1>
                </div>
                <div class="header-right">
                    <div class="search-container">
                        <input type="text" class="search-input" placeholder="Search users...">
                        <i class="fas fa-search search-icon"></i>
                    </div>
                    <div class="user-menu" id="userMenu">
                        <div class="user-avatar-small">
                            <i class="fas fa-user"></i>
                        </div>
                        <span>Admin</span>
                    </div>
                </div>
            </div>

            <!-- User Management Content -->
            <div class="dashboard-content">
                <!-- Page Header -->
                <div class="row">
                    <div class="col-12">
                        <div class="content-card fade-in-up glass-effect">
                            <div class="card-header">
                                <h5>
                                    <i class="fas fa-users-cog"></i>
                                    User Management System
                                </h5>
                                <div class="card-actions">
                                    <button class="action-btn primary" onclick="addNewUser()">
                                        <i class="fas fa-plus"></i>
                                        <span>Add New User</span>
                                    </button>
                                    <button class="action-btn secondary" onclick="exportUsers()">
                                        <i class="fas fa-download"></i>
                                        <span>Export Users</span>
                                    </button>
                                </div>
                            </div>
                            <div class="card-content">
                                <p class="text-light">Manage all users, roles, and permissions in your healthcare platform.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Statistics -->
                <div class="row">
                    <div class="col-lg-3 col-md-6 fade-in-up">
                        <div class="stat-card glass-effect">
                            <div class="stat-icon users">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="stat-content">
                                <h3>1,248</h3>
                                <p>Total Users</p>
                                <div class="stat-change positive">
                                    <i class="fas fa-arrow-up"></i>
                                    <span>+12.5%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6 fade-in-up">
                        <div class="stat-card glass-effect">
                            <div class="stat-icon patients">
                                <i class="fas fa-user-injured"></i>
                            </div>
                            <div class="stat-content">
                                <h3>892</h3>
                                <p>Patients</p>
                                <div class="stat-change positive">
                                    <i class="fas fa-arrow-up"></i>
                                    <span>+8.3%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6 fade-in-up">
                        <div class="stat-card glass-effect">
                            <div class="stat-icon doctors">
                                <i class="fas fa-user-md"></i>
                            </div>
                            <div class="stat-content">
                                <h3>156</h3>
                                <p>Healthcare Providers</p>
                                <div class="stat-change positive">
                                    <i class="fas fa-arrow-up"></i>
                                    <span>+15.2%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6 fade-in-up">
                        <div class="stat-card glass-effect">
                            <div class="stat-icon admin">
                                <i class="fas fa-user-shield"></i>
                            </div>
                            <div class="stat-content">
                                <h3>12</h3>
                                <p>Administrators</p>
                                <div class="stat-change neutral">
                                    <i class="fas fa-minus"></i>
                                    <span>No change</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filters and Actions -->
                <div class="row">
                    <div class="col-12">
                        <div class="content-card fade-in-up glass-effect">
                            <div class="card-header">
                                <h5>
                                    <i class="fas fa-filter"></i>
                                    User Filters & Actions
                                </h5>
                            </div>
                            <div class="card-content">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="filter-group">
                                            <label>Role</label>
                                            <select class="form-control" id="roleFilter">
                                                <option value="">All Roles</option>
                                                <option value="patient">Patient</option>
                                                <option value="doctor">Healthcare Provider</option>
                                                <option value="admin">Administrator</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="filter-group">
                                            <label>Status</label>
                                            <select class="form-control" id="statusFilter">
                                                <option value="">All Status</option>
                                                <option value="active">Active</option>
                                                <option value="inactive">Inactive</option>
                                                <option value="pending">Pending</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="filter-group">
                                            <label>Registration Date</label>
                                            <input type="date" class="form-control" id="dateFilter">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="filter-group">
                                            <label>Actions</label>
                                            <div class="btn-group">
                                                <button class="action-btn info" onclick="applyFilters()">
                                                    <i class="fas fa-search"></i>
                                                    Apply
                                                </button>
                                                <button class="action-btn secondary" onclick="clearFilters()">
                                                    <i class="fas fa-times"></i>
                                                    Clear
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Users Table -->
                <div class="row">
                    <div class="col-12">
                        <div class="content-card fade-in-up glass-effect">
                            <div class="card-header">
                                <h5>
                                    <i class="fas fa-table"></i>
                                    Users Database
                                </h5>
                                <div class="card-actions">
                                    <span class="text-light">Showing 1-3 of 1,248 users</span>
                                </div>
                            </div>
                            <div class="card-content">
                                <div class="table-responsive">
                                    <table class="users-table">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <input type="checkbox" id="selectAll">
                                                </th>
                                                <th>User</th>
                                                <th>Role</th>
                                                <th>Status</th>
                                                <th>Last Login</th>
                                                <th>Registration Date</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="usersTableBody">
                                            <tr>
                                                <td><input type="checkbox" class="user-checkbox"></td>
                                                <td>
                                                    <div class="user-info">
                                                        <div class="user-avatar-table">
                                                            <i class="fas fa-user"></i>
                                                        </div>
                                                        <div class="user-details">
                                                            <h6>Dr. Sarah Johnson</h6>
                                                            <p>sarah.johnson@example.com</p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="role-badge doctor">
                                                        <i class="fas fa-user-md"></i>
                                                        Healthcare Provider
                                                    </span>
                                                </td>
                                                <td><span class="status-badge active">Active</span></td>
                                                <td>2 hours ago</td>
                                                <td>Dec 15, 2023</td>
                                                <td>
                                                    <div class="action-buttons">
                                                        <button class="action-btn small primary" onclick="viewUser(1)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <button class="action-btn small info" onclick="editUser(1)">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="action-btn small warning" onclick="suspendUser(1)">
                                                            <i class="fas fa-ban"></i>
                                                        </button>
                                                        <button class="action-btn small danger" onclick="deleteUser(1)">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td><input type="checkbox" class="user-checkbox"></td>
                                                <td>
                                                    <div class="user-info">
                                                        <div class="user-avatar-table">
                                                            <i class="fas fa-user"></i>
                                                        </div>
                                                        <div class="user-details">
                                                            <h6>John Doe</h6>
                                                            <p>john.doe@example.com</p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="role-badge patient">
                                                        <i class="fas fa-user-injured"></i>
                                                        Patient
                                                    </span>
                                                </td>
                                                <td><span class="status-badge active">Active</span></td>
                                                <td>5 hours ago</td>
                                                <td>Dec 10, 2023</td>
                                                <td>
                                                    <div class="action-buttons">
                                                        <button class="action-btn small primary" onclick="viewUser(2)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <button class="action-btn small info" onclick="editUser(2)">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="action-btn small warning" onclick="suspendUser(2)">
                                                            <i class="fas fa-ban"></i>
                                                        </button>
                                                        <button class="action-btn small danger" onclick="deleteUser(2)">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td><input type="checkbox" class="user-checkbox"></td>
                                                <td>
                                                    <div class="user-info">
                                                        <div class="user-avatar-table">
                                                            <i class="fas fa-user"></i>
                                                        </div>
                                                        <div class="user-details">
                                                            <h6>Admin User</h6>
                                                            <p>admin@homecare.com</p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="role-badge admin">
                                                        <i class="fas fa-user-shield"></i>
                                                        Administrator
                                                    </span>
                                                </td>
                                                <td><span class="status-badge active">Active</span></td>
                                                <td>1 hour ago</td>
                                                <td>Nov 28, 2023</td>
                                                <td>
                                                    <div class="action-buttons">
                                                        <button class="action-btn small primary" onclick="viewUser(3)">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                        <button class="action-btn small info" onclick="editUser(3)">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <button class="action-btn small secondary" disabled>
                                                            <i class="fas fa-lock"></i>
                                                        </button>
                                                        <button class="action-btn small secondary" disabled>
                                                            <i class="fas fa-shield-alt"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                
                                <!-- Pagination -->
                                <div class="pagination-container">
                                    <div class="pagination-info">
                                        <span>Showing 1-3 of 1,248 users</span>
                                    </div>
                                    <div class="pagination-controls">
                                        <button class="pagination-btn" disabled>
                                            <i class="fas fa-angle-left"></i>
                                        </button>
                                        <button class="pagination-btn active">1</button>
                                        <button class="pagination-btn">2</button>
                                        <button class="pagination-btn">3</button>
                                        <button class="pagination-btn">...</button>
                                        <button class="pagination-btn">125</button>
                                        <button class="pagination-btn">
                                            <i class="fas fa-angle-right"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bulk Actions -->
                <div class="row">
                    <div class="col-12">
                        <div class="content-card fade-in-up glass-effect">
                            <div class="card-header">
                                <h5>
                                    <i class="fas fa-tasks"></i>
                                    Bulk Actions
                                </h5>
                            </div>
                            <div class="card-content">
                                <div class="row">
                                    <div class="col-md-8">
                                        <p class="text-light">Select users from the table above to perform bulk actions.</p>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="bulk-actions">
                                            <button class="action-btn info" onclick="bulkAction('activate')">
                                                <i class="fas fa-check"></i>
                                                Activate Selected
                                            </button>
                                            <button class="action-btn warning" onclick="bulkAction('suspend')">
                                                <i class="fas fa-ban"></i>
                                                Suspend Selected
                                            </button>
                                            <button class="action-btn danger" onclick="bulkAction('delete')">
                                                <i class="fas fa-trash"></i>
                                                Delete Selected
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/dashboard.js"></script>
    <script>
        // User Management Functions
        function addNewUser() {
            Swal.fire({
                title: 'Add New User',
                html: `
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" class="form-control" id="userName" placeholder="Enter full name">
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" class="form-control" id="userEmail" placeholder="Enter email">
                    </div>
                    <div class="form-group">
                        <label>Role</label>
                        <select class="form-control" id="userRole">
                            <option value="patient">Patient</option>
                            <option value="doctor">Healthcare Provider</option>
                            <option value="admin">Administrator</option>
                        </select>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Add User',
                cancelButtonText: 'Cancel',
                preConfirm: () => {
                    return {
                        name: document.getElementById('userName').value,
                        email: document.getElementById('userEmail').value,
                        role: document.getElementById('userRole').value
                    };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Success!', 'User has been added successfully.', 'success');
                }
            });
        }

        function exportUsers() {
            Swal.fire({
                title: 'Export Users',
                text: 'Select export format:',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Export CSV',
                cancelButtonText: 'Export PDF',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Exporting...', 'CSV export is being generated.', 'info');
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    Swal.fire('Exporting...', 'PDF export is being generated.', 'info');
                }
            });
        }

        function viewUser(userId) {
            Swal.fire({
                title: 'User Details',
                html: `
                    <div class="user-details-modal">
                        <div class="user-avatar-large">
                            <i class="fas fa-user"></i>
                        </div>
                        <h4>Dr. Sarah Johnson</h4>
                        <p>sarah.johnson@example.com</p>
                        <div class="user-stats">
                            <div class="stat-item">
                                <span class="label">Role:</span>
                                <span class="value">Healthcare Provider</span>
                            </div>
                            <div class="stat-item">
                                <span class="label">Status:</span>
                                <span class="value">Active</span>
                            </div>
                            <div class="stat-item">
                                <span class="label">Last Login:</span>
                                <span class="value">2 hours ago</span>
                            </div>
                        </div>
                    </div>
                `,
                width: '500px',
                showConfirmButton: false,
                showCancelButton: true,
                cancelButtonText: 'Close'
            });
        }

        function editUser(userId) {
            Swal.fire({
                title: 'Edit User',
                html: `
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" class="form-control" id="editUserName" value="Dr. Sarah Johnson">
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" class="form-control" id="editUserEmail" value="sarah.johnson@example.com">
                    </div>
                    <div class="form-group">
                        <label>Role</label>
                        <select class="form-control" id="editUserRole">
                            <option value="patient">Patient</option>
                            <option value="doctor" selected>Healthcare Provider</option>
                            <option value="admin">Administrator</option>
                        </select>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Update User',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Success!', 'User has been updated successfully.', 'success');
                }
            });
        }

        function suspendUser(userId) {
            Swal.fire({
                title: 'Suspend User',
                text: 'Are you sure you want to suspend this user?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Suspend',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#ffc107'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Suspended!', 'User has been suspended.', 'success');
                }
            });
        }

        function deleteUser(userId) {
            Swal.fire({
                title: 'Delete User',
                text: 'Are you sure you want to delete this user? This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc3545'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Deleted!', 'User has been deleted.', 'success');
                }
            });
        }

        function applyFilters() {
            Swal.fire('Filters Applied!', 'Users have been filtered based on your selection.', 'info');
        }

        function clearFilters() {
            document.getElementById('roleFilter').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('dateFilter').value = '';
            Swal.fire('Filters Cleared!', 'All filters have been reset.', 'info');
        }

        function bulkAction(action) {
            const selected = document.querySelectorAll('.user-checkbox:checked').length;
            if (selected === 0) {
                Swal.fire('No Selection', 'Please select at least one user.', 'warning');
                return;
            }

            let message = '';
            let title = '';
            switch(action) {
                case 'activate':
                    title = 'Activate Users';
                    message = `Are you sure you want to activate ${selected} selected user(s)?`;
                    break;
                case 'suspend':
                    title = 'Suspend Users';
                    message = `Are you sure you want to suspend ${selected} selected user(s)?`;
                    break;
                case 'delete':
                    title = 'Delete Users';
                    message = `Are you sure you want to delete ${selected} selected user(s)? This action cannot be undone.`;
                    break;
            }

            Swal.fire({
                title: title,
                text: message,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Continue',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Success!', `${selected} user(s) have been ${action}d.`, 'success');
                }
            });
        }

        // Logout function
        function handleLogout() {
            Swal.fire({
                title: 'Logout Confirmation',
                text: 'Are you sure you want to logout?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Logout',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#159BBD'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('Logged Out!', 'You have been successfully logged out.', 'success').then(() => {
                        window.location.href = '/login';
                    });
                }
            });
        }

        // Select all checkbox functionality
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.user-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });
    </script>

    <style>
        .stat-icon.patients {
            background: linear-gradient(135deg, #28a745, #20c997);
        }

        .stat-icon.doctors {
            background: linear-gradient(135deg, #17a2b8, #138496);
        }

        .stat-icon.admin {
            background: linear-gradient(135deg, #6f42c1, #563d7c);
        }

        .filter-group {
            margin-bottom: 1rem;
        }

        .filter-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: var(--text-dark);
        }

        .form-control {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(21, 155, 189, 0.1);
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            color: white;
        }

        .role-badge.patient {
