rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🔐 ADMIN ACCESS - Accès spécifique pour l'admin
    match /clinics/{clinicId} {
      // Admin peut tout voir et modifier (AUTHENTIFIÉ)
      allow read, write: if request.auth != null && 
        (request.auth.uid == 'EjupRzLvztdxrnox2xWLXAe5Oct1' ||
         request.auth.token.email == 'admin@homecare.com');
      
      // 🚨 ACCÈS TEMPORAIRE POUR ADMIN DASHBOARD (À RETIRER EN PRODUCTION)
      allow read, write: if true;
      
      // Cliniques peuvent gérer leur propre profil (INCHANGÉ)
      allow read, write: if request.auth != null && clinicId == request.auth.uid;
      
      // Patients peuvent voir les profils des cliniques (INCHANGÉ) 
      allow read: if request.auth != null;
    }
    
    // 🩺 PATIENTS COLLECTION - Ajouté pour getUserType()
    match /patients/{patientId} {
      // Admin peut tout voir et modifier
      allow read, write: if request.auth != null && 
        (request.auth.uid == 'EjupRzLvztdxrnox2xWLXAe5Oct1' ||
         request.auth.token.email == 'admin@homecare.com');
      
      // 🚨 ACCÈS TEMPORAIRE POUR RÉSOUDRE LES PROBLÈMES DE LOGIN
      allow read, write: if true;
      
      // Patients peuvent gérer leur propre profil
      allow read, write: if request.auth != null && patientId == request.auth.uid;
      
      // Cliniques peuvent voir les profils patients pour chat
      allow read: if request.auth != null && isClinic();
    }
    
    // 👤 USERS COLLECTION - Règles assouplies pour le login
    match /users/{userId} {
      // Admin peut tout voir et modifier
      allow read, write: if request.auth != null && 
        (request.auth.uid == 'EjupRzLvztdxrnox2xWLXAe5Oct1' ||
         request.auth.token.email == 'admin@homecare.com');
      
      // 🚨 ACCÈS TEMPORAIRE POUR RÉSOUDRE LES PROBLÈMES DE LOGIN
      allow read, write: if true;
      
      // Utilisateurs peuvent gérer leur propre profil
      allow read, write: if request.auth != null && userId == request.auth.uid;
      
      // Cliniques peuvent voir les profils patients pour chat
      allow read: if request.auth != null && isClinic();
      
      // Permettre la lecture pour getUserType() même sans être connecté spécifiquement à ce document
      allow read: if request.auth != null;
    }

    // 🏥 SUGGESTIONS COLLECTION - Nouveau pour les suggestions d'hôpitaux
    match /suggestions/{suggestionId} {
      // Admin peut tout voir et modifier
      allow read, write: if request.auth != null && 
        (request.auth.uid == 'EjupRzLvztdxrnox2xWLXAe5Oct1' ||
         request.auth.token.email == 'admin@homecare.com');
      
      // 🚨 ACCÈS TEMPORAIRE POUR ADMIN DASHBOARD
      allow read, write: if true;
      
      // Utilisateurs authentifiés peuvent créer des suggestions
      allow create: if request.auth != null;
      
      // Utilisateurs peuvent voir leurs propres suggestions
      allow read: if request.auth != null && resource.data.suggestedBy == request.auth.uid;
      
      // Utilisateurs peuvent modifier leurs propres suggestions (optionnel)
      allow update: if request.auth != null && resource.data.suggestedBy == request.auth.uid;
    }
    
    // 👥 CHAT CONVERSATIONS - INCHANGÉ (patients + cliniques)
    match /chat_conversations/{conversationId} {
      // 🚨 ACCÈS TEMPORAIRE POUR ADMIN DASHBOARD
      allow read, write: if true;
      
      allow read, write: if request.auth != null && 
        (resource.data.patientId == request.auth.uid || 
         resource.data.clinicId == request.auth.uid);
      
      allow create: if request.auth != null && 
        (request.resource.data.patientId == request.auth.uid || 
         request.resource.data.clinicId == request.auth.uid);
    }
    
    // 💬 CHAT MESSAGES - INCHANGÉ (patients + cliniques)
    match /chat_messages/{messageId} {
      // 🚨 ACCÈS TEMPORAIRE POUR ADMIN DASHBOARD
      allow read, write: if true;
      
      allow read: if request.auth != null && 
        (isPatientInConversation(resource.data.conversationId) || 
         isClinicInConversation(resource.data.conversationId));
      
      allow create: if request.auth != null && 
        (request.resource.data.senderId == request.auth.uid);
      
      allow update: if request.auth != null && 
        (isPatientInConversation(resource.data.conversationId) || 
         isClinicInConversation(resource.data.conversationId));
    }
    
    // 📅 APPOINTMENTS - INCHANGÉ (patients + cliniques)
    match /appointments/{appointmentId} {
      // 🚨 ACCÈS TEMPORAIRE POUR ADMIN DASHBOARD 
      allow read, write: if true;
      
      allow read, write: if request.auth != null && 
        (resource.data.patientId == request.auth.uid || 
         isClinicForHospital(resource.data.hospital));
      
      allow create: if request.auth != null;
    }
    
    // 🔧 FONCTIONS HELPER - INCHANGÉES avec gestion d'erreur améliorée
    function isClinic() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/clinics/$(request.auth.uid));
    }
    
    function isPatientInConversation(conversationId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/chat_conversations/$(conversationId)) &&
        get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data.patientId == request.auth.uid;
    }
    
    function isClinicInConversation(conversationId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/chat_conversations/$(conversationId)) &&
        get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data.clinicId == request.auth.uid;
    }
    
    function isClinicForHospital(hospitalName) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/clinics/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/clinics/$(request.auth.uid)).data.name == hospitalName ||
         get(/databases/$(database)/documents/clinics/$(request.auth.uid)).data.clinicName == hospitalName);
    }
  }
} 